@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var returnUrl = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        try
        {
            var clerkConfig = await JS.InvokeAsync<ClerkClientConfig>("courtflowClerk.getConfig");
            var session = await JS.InvokeAsync<ClerkSessionInfo?>(
                "courtflowClerk.getSessionInfo",
                clerkConfig.PublishableKey,
                clerkConfig.FrontendApi);

            if (!string.IsNullOrWhiteSpace(session?.Token) &&
                AuthStateProvider is CourtFlow.Web.Client.Authentication.JwtAuthenticationStateProvider jwtProvider)
            {
                await jwtProvider.MarkAuthenticatedAsync();
                return;
            }
        }
        catch (InvalidOperationException)
        {
            // JS interop may be unavailable during early render; fall through to login redirect.
        }
        catch (JSException)
        {
            // Clerk script/config may not be loaded yet; fall through to login redirect.
        }

        Nav.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false, replace: true);
    }

    private sealed class ClerkClientConfig
    {
        public string PublishableKey { get; set; } = string.Empty;
        public string FrontendApi { get; set; } = string.Empty;
    }

    private sealed class ClerkSessionInfo
    {
        public string? Token { get; set; }
    }
}
