@page "/"
@attribute [AllowAnonymous]
@layout PublicLayout
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject NavigationManager Nav

<PageTitle>Events · CourtFlow</PageTitle>

<MudStack Spacing="6">
    <MudPaper Elevation="0" Class="pa-8" Style="background: linear-gradient(135deg, #245F73 0%, #1E4F60 100%); color: #F2F0EF; border-radius: 16px; border: 1px solid rgba(242,240,239,0.14);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">Volleyball tournaments, live.</MudText>
            <MudText Typo="Typo.subtitle1" Style="opacity: 0.9; max-width: 640px;">
                Browse current and upcoming events, follow schedules, and check standings in real time.
            </MudText>
        </MudStack>
    </MudPaper>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">Current &amp; upcoming events</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh" OnClick="LoadAsync" />
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_events.Count == 0)
    {
        <MudPaper Class="pa-8" Outlined="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">No events scheduled right now</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        @EventGrid(_events)
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-4">
        <MudText Typo="Typo.h5">Past events</MudText>
    </MudStack>

    @if (_pastLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_pastEvents.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">No archived or completed events yet.</MudAlert>
    }
    else
    {
        @EventGrid(_pastEvents)
    }
</MudStack>

@code {
    private IReadOnlyList<CourtFlow.ApiClient.PublicEventDto> _events = Array.Empty<CourtFlow.ApiClient.PublicEventDto>();
    private IReadOnlyList<CourtFlow.ApiClient.PublicEventDto> _pastEvents = Array.Empty<CourtFlow.ApiClient.PublicEventDto>();
    private bool _loading = true;
    private bool _pastLoading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _pastLoading = true;
        try { _events = await Api.PublicEvents.ListAsync(); }
        catch { _events = Array.Empty<CourtFlow.ApiClient.PublicEventDto>(); }
        finally { _loading = false; }

        try { _pastEvents = await Api.PublicEvents.ListPastAsync(); }
        catch { _pastEvents = Array.Empty<CourtFlow.ApiClient.PublicEventDto>(); }
        finally { _pastLoading = false; }
    }

    private void View(Guid id) => Nav.NavigateTo($"/events/{id}");

    private RenderFragment EventGrid(IReadOnlyList<CourtFlow.ApiClient.PublicEventDto> events) => @<MudGrid>
        @foreach (var e in events)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" Class="h-100 d-flex flex-column" Style="cursor: pointer;" @onclick="() => View(e.Id)">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@e.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@e.OrganizationName</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(e)" Variant="Variant.Filled">@StatusLabel(e)</MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="flex-grow-1">
                        <MudText Typo="Typo.body2">@FormatDates(e.StartDate, e.EndDate)</MudText>
                        <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.caption">@e.VenueCount venues</MudText>
                            <MudText Typo="Typo.caption">·</MudText>
                            <MudText Typo="Typo.caption">@e.DivisionCount divisions</MudText>
                            <MudText Typo="Typo.caption">·</MudText>
                            <MudText Typo="Typo.caption">@e.TeamCount teams</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">View event</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>;

    private static string FormatDates(DateOnly start, DateOnly end)
    {
        if (start == end) return start.ToString("MMM d, yyyy");
        return $"{start:MMM d} – {end:MMM d, yyyy}";
    }

    private static string StatusLabel(CourtFlow.ApiClient.PublicEventDto e)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        if (today < e.StartDate) return "Upcoming";
        if (today > e.EndDate) return "Completed";
        return "Live";
    }

    private static Color StatusColor(CourtFlow.ApiClient.PublicEventDto e)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        if (today < e.StartDate) return Color.Info;
        if (today > e.EndDate) return Color.Default;
        return Color.Success;
    }
}
