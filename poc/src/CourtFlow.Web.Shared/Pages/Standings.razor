@page "/standings"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Standings · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h4">Pool Standings</MudText>
        @if (!string.IsNullOrEmpty(_tiebreakerPreset))
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" title="Active tiebreaker chain">@_tiebreakerPreset</MudChip>
        }
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <CfSelect T="Guid?" @bind-Value="_divisionId" Label="Division"
                   @bind-Value:after="ReloadAsync" Class="cf-select--md"
                   ToStringFunc="_divisionName">
            @foreach (var d in _divisions)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)d.Id)">@d.Name</MudSelectItem>
            }
        </CfSelect>
    </MudStack>
</MudStack>

@if (_standings.Count == 0)
{
    <MudAlert Severity="Severity.Info">No standings yet. Enter scores to populate.</MudAlert>
}
else
{
    foreach (var pool in _standings)
    {
        <MudPaper Class="mb-4 pa-3" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">@pool.PoolName</MudText>
            <MudTable Items="pool.Rows" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Team</MudTh>
                    <MudTh>MP</MudTh>
                    <MudTh>W</MudTh>
                    <MudTh>L</MudTh>
                    <MudTh>SW</MudTh>
                    <MudTh>SL</MudTh>
                    <MudTh>Set %</MudTh>
                    <MudTh>PF</MudTh>
                    <MudTh>PA</MudTh>
                    <MudTh>Pt %</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd>@row.Rank</MudTd>
                    <MudTd>@row.TeamName</MudTd>
                    <MudTd>@row.MatchesPlayed</MudTd>
                    <MudTd>@row.MatchWins</MudTd>
                    <MudTd>@row.MatchLosses</MudTd>
                    <MudTd>@row.SetsWon</MudTd>
                    <MudTd>@row.SetsLost</MudTd>
                    <MudTd>@row.SetPercentage.ToString("P1")</MudTd>
                    <MudTd>@row.PointsFor</MudTd>
                    <MudTd>@row.PointsAgainst</MudTd>
                    <MudTd>@row.PointPercentage.ToString("P1")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private IReadOnlyList<DivisionDto> _divisions = Array.Empty<DivisionDto>();
    private IReadOnlyList<PoolStandingsDto> _standings = Array.Empty<PoolStandingsDto>();
    private string? _tiebreakerPreset;
    private Guid? _divisionId;

    private Func<Guid?, string> _divisionName =>
        id => id is null ? string.Empty
            : _divisions.FirstOrDefault(d => d.Id == id)?.Name ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await TournamentStore.EnsureInitializedAsync();
            await OnTournamentChanged();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task OnTournamentChanged()
    {
        var tid = TournamentStore.SelectedTournamentId;
        _divisions = tid is null ? Array.Empty<DivisionDto>() : await Api.Divisions.ListAsync(tid);
        _divisionId = _divisions.Count > 0 ? _divisions[0].Id : null;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            if (_divisionId is null)
            {
                _standings = Array.Empty<PoolStandingsDto>();
                _tiebreakerPreset = null;
            }
            else
            {
                var result = await Api.Standings.ForDivisionAsync(_divisionId.Value);
                _tiebreakerPreset = result.TiebreakerPreset;
                _standings = result.Pools;
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

}
