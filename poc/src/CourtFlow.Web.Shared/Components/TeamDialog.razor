@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Class="mud-width-full">
            <CfSelect T="Guid"
                       @bind-Value="_divisionId"
                       Label="Division"
                       Class="mud-width-full"
                       Required="true">
                @foreach (var d in Divisions)
                {
                    <MudSelectItem Value="d.Id">@d.Name</MudSelectItem>
                }
            </CfSelect>
            <CfTextField @bind-Value="_name"
                          Label="Team name"
                          Required="true"
                          FullWidth="true"
                          InputType="InputType.Text"
                          Lines="1" />
            <MudStack Spacing="0">
                <CfAutocomplete T="string"
                                 @bind-Value="_clubText"
                                 Label="Club"
                                 Class="mud-width-full"
                                 Clearable="true"
                                 Strict="false"
                                 CoerceText="true"
                                 ResetValueOnEmptyText="true"
                                 Placeholder="Existing club or new name"
                                 MaxItems="30"
                                 SearchFunc="SearchClubsAsync" />
                <MudText Typo="Typo.caption" Class="mud-opacity-70 mt-1">Pick from the list or type to add a new club for this tournament.</MudText>
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public TeamDto? Existing { get; set; }
    [Parameter] public IReadOnlyList<DivisionDto> Divisions { get; set; } = Array.Empty<DivisionDto>();
    [Parameter] public IReadOnlyList<string> ClubOptions { get; set; } = Array.Empty<string>();
    [Parameter] public Guid? InitialDivisionId { get; set; }

    private Guid _divisionId;
    private string _name = "";
    /// <summary>Empty = no club. May be a new name not yet in <see cref="ClubOptions"/>.</summary>
    private string _clubText = "";

    private string? ClubForApi => string.IsNullOrWhiteSpace(_clubText) ? null : _clubText.Trim();

    protected override void OnParametersSet()
    {
        if (Existing is not null)
        {
            _divisionId = Existing.DivisionId;
            _name = Existing.Name;
            _clubText = string.IsNullOrWhiteSpace(Existing.Club) ? "" : Existing.Club.Trim();
        }
        else
        {
            _name = "";
            _clubText = "";
            _divisionId = InitialDivisionId ?? Divisions.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private Task<IEnumerable<string>> SearchClubsAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(ClubOptions.AsEnumerable());

        var v = value.Trim();
        var matches = ClubOptions
            .Where(c => c.Contains(v, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var hasExact = matches.Exists(s => string.Equals(s, v, StringComparison.OrdinalIgnoreCase))
            || ClubOptions.Any(c => string.Equals(c, v, StringComparison.OrdinalIgnoreCase));
        if (!hasExact)
            matches.Insert(0, v);

        return Task.FromResult<IEnumerable<string>>(matches);
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Save()
    {
        if (_divisionId == Guid.Empty || string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Division and team name are required.", Severity.Warning);
            return;
        }
        var club = ClubForApi;
        if (club is { Length: > 200 })
        {
            Snackbar.Add("Club name must be 200 characters or less.", Severity.Warning);
            return;
        }
        try
        {
            TeamDto saved;
            if (Existing is null)
                saved = await Api.Teams.CreateAsync(new CreateTeamDto(_divisionId, _name.Trim(), club));
            else
            {
                if (_divisionId != Existing.DivisionId)
                    await Api.Teams.MoveDivisionAsync(Existing.Id, new MoveTeamDto(_divisionId));
                saved = await Api.Teams.UpdateAsync(new UpdateTeamDto(Existing.Id, _name.Trim(), club));
            }
            Snackbar.Add("Saved", Severity.Success);
            Dialog.Close(DialogResult.Ok(saved));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
