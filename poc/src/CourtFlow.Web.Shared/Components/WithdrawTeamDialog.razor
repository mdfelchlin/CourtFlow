@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudStack Spacing="2">
                <CfSelect T="Guid?"
                           @bind-Value="_tournamentTeamId"
                           Label="Team"
                           Required="true"
                           ToStringFunc="@FormatTeam">
                    @foreach (var t in _teams)
                    {
                        <MudSelectItem Value="@t.TournamentTeamId">@FormatTeam(t.TournamentTeamId)</MudSelectItem>
                    }
                </CfSelect>
                <CfTextField @bind-Value="_reason" Label="Reason" Lines="2" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Withdrawal is recorded against the tournament team entry and creates a repair job audit trail.
                </MudText>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Withdraw" Disabled="_loading || _tournamentTeamId is null">Withdraw</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid TournamentId { get; set; }

    private bool _loading = true;
    private Guid? _tournamentTeamId;
    private string? _reason;
    private List<TeamDto> _teams = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var divisions = await Api.Divisions.ListAsync(TournamentId);
            var divNames = divisions.ToDictionary(d => d.Id, d => d.Name);
            var teams = await Api.Teams.ListAsync(TournamentId);
            _teams = teams
                .Where(t => t.TournamentTeamId is not null)
                .OrderBy(t => divNames.GetValueOrDefault(t.DivisionId, ""))
                .ThenBy(t => t.Name)
                .ToList();
            _tournamentTeamId = _teams.FirstOrDefault()?.TournamentTeamId;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatTeam(Guid? id)
    {
        if (id is null) return "";
        var t = _teams.FirstOrDefault(x => x.TournamentTeamId == id);
        return t is null ? id.ToString()! : t.Name;
    }

    private void Cancel() => Dialog.Cancel();

    private void Withdraw()
    {
        if (_tournamentTeamId is null) return;
        Dialog.Close(DialogResult.Ok(new TeamWithdrawalDto(_tournamentTeamId.Value, _reason, null)));
    }
}
