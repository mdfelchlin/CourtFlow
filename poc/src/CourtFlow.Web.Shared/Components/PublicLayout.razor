@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState Theme
@inject IJSRuntime JS
@inject NavigationManager Nav

<MudThemeProvider Theme="Theme.CurrentTheme" IsDarkMode="Theme.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" Dense="true">
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <img src="/CourtFlow.png" alt="CourtFlow logo" style="width: 44px; height: 44px; border-radius: 4px;" />
                <MudText Typo="Typo.h6">CourtFlow</MudText>
            </MudStack>
        </MudLink>
        <MudSpacer />
        <MudTooltip Text="@(Theme.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton
                Icon="@(Theme.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                Color="Color.Inherit"
                aria-label="Toggle theme"
                OnClick="ToggleThemeAsync" />
        </MudTooltip>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/tournaments" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.EmojiEvents" Class="ml-2">Admin</MudButton>
                <MudText Typo="Typo.body2" Class="mx-2">@context.User.Identity?.Name</MudText>
                <MudButton Href="/logout" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">Logout</MudButton>
            </Authorized>
            <NotAuthorized>
                @if (!IsOnLoginPage)
                {
                    <MudButton Href="@LoginHref" Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Login" Class="ml-2">Sign in</MudButton>
                }
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    private string LoginHref => $"/login?returnUrl={Uri.EscapeDataString("/tournaments")}";
    private bool IsOnLoginPage => new Uri(Nav.Uri).AbsolutePath
        .TrimEnd('/')
        .Equals("/login", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Theme.OnChanged += OnThemeChanged;
    }

    private async Task ToggleThemeAsync()
    {
        Theme.Toggle();
        try
        {
            await JS.InvokeVoidAsync("courtflowTheme.setCookie", Theme.IsDarkMode ? "dark" : "light");
        }
        catch (InvalidOperationException)
        {
            // JS interop not available during prerender; cookie will be set on next interaction.
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.OnChanged -= OnThemeChanged;
}
