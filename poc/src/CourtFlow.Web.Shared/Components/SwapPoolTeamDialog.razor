<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Swap <strong>@TeamDisplay.Label(Team.Club, Team.Name)</strong> with another team.
        </MudText>
        <CfSelect T="Guid?"
                   @bind-Value="_otherTeamId"
                   Label="Swap with"
                   Required="true"
                   ToStringFunc="@FormatTeam">
            @foreach (var t in OtherTeams)
            {
                <MudSelectItem T="Guid?" Value="@t.Id">@FormatTeam(t.Id)</MudSelectItem>
            }
        </CfSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm" Disabled="_otherTeamId is null">Swap</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public TeamDto Team { get; set; } = default!;
    [Parameter] public IReadOnlyList<TeamDto> OtherTeams { get; set; } = Array.Empty<TeamDto>();
    [Parameter] public IReadOnlyDictionary<Guid, string> PoolNames { get; set; } = new Dictionary<Guid, string>();

    private Guid? _otherTeamId;

    private string FormatTeam(Guid? id)
    {
        if (id is null) return "";
        var t = OtherTeams.FirstOrDefault(x => x.Id == id);
        if (t is null) return id.ToString()!;
        var poolLabel = t.PoolId is { } pid && PoolNames.TryGetValue(pid, out var name)
            ? name
            : "pool";
        return $"{TeamDisplay.Label(t.Club, t.Name)} · {poolLabel} #{t.SeedInPool}";
    }

    private void Cancel() => Dialog.Cancel();

    private void Confirm()
    {
        if (_otherTeamId is null) return;
        Dialog.Close(DialogResult.Ok(_otherTeamId.Value));
    }
}
