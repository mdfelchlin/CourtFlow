subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "westus2"
project_name    = "courtflow"
environment     = "dev"

min_replicas = 0
max_replicas = 3
api_image    = "mcr.microsoft.com/k8se/quickstart:latest"

# When empty, Terraform sets CORS to https://<SWA default hostname> for this environment.
# Set explicit entries to add more origins (e.g. custom domain, https://localhost:7178).
cors_origins = []

budget_amount = 25
budget_contact_emails = [
  "owner@example.com",
]

connection_string_default = ""
clerk_authority           = ""
clerk_audience            = ""

secrets = {}
