{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/appsettings.json",
      "/clerkInterop.js",
      "/service-worker.js",
      "/service-worker.published.js",
      "/manifest.webmanifest",
      "/index.html",
      "/images/*.{png,jpg,gif,webp,svg}",
      "/css/*",
      "/_framework/*",
      "/_content/*"
    ]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
