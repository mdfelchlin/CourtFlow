<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(CourtFlow.Web.Shared.Components.AppShell).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(CourtFlow.Web.Shared.Components.AppShell)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(CourtFlow.Web.Shared.Components.AppShell)">
            <MudText Typo="Typo.h5">Page not found.</MudText>
        </LayoutView>
    </NotFound>
</Router>
