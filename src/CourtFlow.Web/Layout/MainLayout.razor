@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState ThemeState

<MudThemeProvider Theme="CourtFlowTheme.Theme" IsDarkMode="ThemeState.IsDarkMode" ObserveSystemThemeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Color.Default paints the bar with the palette's AppbarBackground and AppbarText roles, which stay the
       brand teal in both modes even though the dark Primary is lighter. *@
    <MudAppBar Elevation="CfDefaults.AppBarElevation" Color="Color.Default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Toggle navigation"
                       OnClick="ToggleDrawer" />
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Class="ml-2" data-testid="brand-link">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudImage Src="@CourtFlowTheme.LogoPath" Alt="" Width="CourtFlowTheme.LogoSize" Height="CourtFlowTheme.LogoSize" />
                <MudText Typo="Typo.h6" HtmlTag="span">CourtFlow</MudText>
            </MudStack>
        </MudLink>
        <MudSpacer />
        <CfIconButton Icon="@ToggleIcon"
                      Label="@ToggleLabel"
                      Color="Color.Inherit"
                      Size="Size.Medium"
                      OnClick="ToggleThemeAsync"
                      data-testid="theme-toggle" />
    </MudAppBar>
    @* MudBlazor 8.13's mini drawer pushes the content aside at every width. Below the small breakpoint
       the responsive variant is used instead, so the expanded drawer covers the content. The key recreates
       the drawer on a variant change, because MudLayout only recomputes its margins when a drawer registers. *@
    <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />
    <MudDrawer @key="DrawerVariant"
               @bind-Open="drawerOpen"
               Variant="@DrawerVariant"
               OpenMiniOnHover="true"
               ClipMode="DrawerClipMode.Always"
               Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="CfDefaults.ContentMaxWidth" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    public const string SwitchToDark = "Switch to dark theme";
    public const string SwitchToLight = "Switch to light theme";

    private bool drawerOpen;
    private Breakpoint breakpoint = Breakpoint.None;

    private DrawerVariant DrawerVariant => breakpoint == Breakpoint.Xs ? DrawerVariant.Responsive : DrawerVariant.Mini;

    private void OnBreakpointChanged(Breakpoint value) => breakpoint = value;

    private string ToggleIcon => ThemeState.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;
    private string ToggleLabel => ThemeState.IsDarkMode ? SwitchToLight : SwitchToDark;

    protected override void OnInitialized() => ThemeState.Changed += OnThemeChanged;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    private Task ToggleThemeAsync() => ThemeState.ToggleAsync();

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
