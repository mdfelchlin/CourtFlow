@* A numeric field that passes its minimum and maximum through. *@
@typeparam T

<CfField Label="@Label" Required="Required" InputId="@inputId" @attributes="AdditionalAttributes">
    <MudNumericField T="T"
                     Value="Value"
                     ValueChanged="ValueChanged"
                     InputId="@inputId"
                     Variant="CfDefaults.FieldVariant"
                     Margin="CfDefaults.FieldMargin"
                     Required="Required"
                     Disabled="Disabled"
                     Min="Min"
                     Max="Max"
                     FullWidth="true" />
</CfField>

@code {
    private readonly string inputId = CfIds.Next();

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T> ValueChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public T Min { get; set; } = default!;
    [Parameter, EditorRequired] public T Max { get; set; } = default!;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
