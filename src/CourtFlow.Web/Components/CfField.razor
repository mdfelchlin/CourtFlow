@* The shared shell for form fields: a plain label above the control, with an asterisk when required. *@
<div @attributes="AdditionalAttributes">
    <MudText Typo="Typo.subtitle2" Class="mb-1">
        <label id="@LabelId" for="@InputId">
            @Label
            @if (Required)
            {
                <span aria-hidden="true">*</span>
            }
        </label>
    </MudText>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Required { get; set; }

    /// <summary>The id of the control, when MudBlazor exposes one. Ties the label with <c>for</c>.</summary>
    [Parameter] public string? InputId { get; set; }

    /// <summary>The id of the label, for controls that can only point back with <c>aria-labelledby</c>.</summary>
    [Parameter] public string? LabelId { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
