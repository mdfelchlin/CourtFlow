@* A single- or multi-line text field with the CourtFlow look. *@
<CfField Label="@Label" Required="Required" InputId="@inputId" @attributes="AdditionalAttributes">
    <MudTextField T="string"
                  Value="@Value"
                  ValueChanged="ValueChanged"
                  InputId="@inputId"
                  Variant="CfDefaults.FieldVariant"
                  Margin="CfDefaults.FieldMargin"
                  Required="Required"
                  Disabled="Disabled"
                  ReadOnly="ReadOnly"
                  Error="ErrorText is not null"
                  ErrorText="@ErrorText"
                  Lines="Lines"
                  Immediate="Immediate"
                  Placeholder="@Placeholder"
                  FullWidth="true" />
</CfField>

@code {
    private readonly string inputId = CfIds.Next();

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>The field's problem, shown under it. Null when the value is fine.</summary>
    [Parameter] public string? ErrorText { get; set; }

    [Parameter] public int Lines { get; set; } = 1;

    /// <summary>Reports each keystroke rather than waiting for the field to lose focus.</summary>
    [Parameter] public bool Immediate { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
