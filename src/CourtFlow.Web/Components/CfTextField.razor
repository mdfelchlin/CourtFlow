@* A single- or multi-line text field with the CourtFlow look. *@
@if (ShowLabel)
{
    <CfField Label="@Label" Required="Required" InputId="@inputId" @attributes="AdditionalAttributes">
        @Input
    </CfField>
}
else
{
    <div @attributes="AdditionalAttributes">
        @Input
    </div>
}

@code {
    private readonly string inputId = CfIds.Next();

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>The name a screen reader announces. When set, it replaces the visible label.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>When false, the label is not shown. <see cref="AriaLabel"/> still names the field.</summary>
    [Parameter] public bool ShowLabel { get; set; } = true;

    private RenderFragment Input => @<MudTextField T="string"
                                                    Value="@Value"
                                                    ValueChanged="ValueChanged"
                                                    InputId="@inputId"
                                                    aria-label="@AriaLabel"
                                                    Variant="CfDefaults.FieldVariant"
                                                    Margin="CfDefaults.FieldMargin"
                                                    Required="Required"
                                                    Disabled="Disabled"
                                                    ReadOnly="ReadOnly"
                                                    Error="ErrorText is not null"
                                                    ErrorText="@ErrorText"
                                                    Lines="Lines"
                                                    Immediate="Immediate"
                                                    Placeholder="@Placeholder"
                                                    FullWidth="true" />;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>The field's problem, shown under it. Null when the value is fine.</summary>
    [Parameter] public string? ErrorText { get; set; }

    [Parameter] public int Lines { get; set; } = 1;

    /// <summary>Reports each keystroke rather than waiting for the field to lose focus.</summary>
    [Parameter] public bool Immediate { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
