@* A calendar date field over MudBlazor's date picker. Binds DateOnly and accepts typed dates as month/day/year. *@
<CfField Label="@Label" Required="Required" LabelId="@labelId" @attributes="AdditionalAttributes">
    <MudDatePicker Date="@_pickerDate"
                   DateChanged="OnDateChanged"
                   aria-labelledby="@labelId"
                   Variant="CfDefaults.FieldVariant"
                   Margin="CfDefaults.FieldMargin"
                   Required="Required"
                   Disabled="Disabled"
                   Editable="true"
                   Converter="@DateConverter"
                   Culture="@CalendarDateFormat.Culture"
                   DateFormat="@CalendarDateFormat.Pattern"
                   Placeholder="@CalendarDateFormat.Placeholder"
                   Text="@_text"
                   TextChanged="OnTextChanged" />
</CfField>

@code {
    // MudBlazor parses with one format string, and MM/dd rejects a single digit. This converter
    // accepts 9/1/2026 and still shows 09/01/2026.
    private static readonly IReversibleConverter<DateTime?, string?> DateConverter = Conversions.From<DateTime?, string?>(
        date => date is null ? null : CalendarDateFormat.Display(DateOnly.FromDateTime(date.Value)),
        text => CalendarDateFormat.TryParse(text, out var date)
            ? date.ToDateTime(TimeOnly.MinValue)
            : null);

    private readonly string labelId = CfIds.Next();
    private DateOnly? _value;
    private DateTime? _pickerDate;
    // MudBlazor keeps typed text that already parses to the current date, so 9/1/2026 would stay
    // as typed. Owning the text lets a parsed date show as 09/01/2026. Text must follow Converter
    // and Culture in the markup: the picker parses it as soon as it is set.
    private string? _text;
    private bool _publishing;

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (Value == _value)
            return;

        _value = Value;
        _pickerDate = ToDateTime(Value);
        _text = DateConverter.Convert(_pickerDate);
    }

    private static DateTime? ToDateTime(DateOnly? date) =>
        date?.ToDateTime(TimeOnly.MinValue);

    private void OnTextChanged(string? text) =>
        _text = DateConverter.ConvertBack(text) is { } date ? DateConverter.Convert(date) : text;

    private async Task OnDateChanged(DateTime? date)
    {
        // Parsing raises the new date, then the picker re-renders with the previous null
        // parameter and raises null. Ignore that echo. A real clear arrives on its own.
        if (date is null && _publishing)
            return;

        _pickerDate = date;
        _value = date is null ? null : DateOnly.FromDateTime(date.Value);
        _publishing = date is not null;
        try
        {
            await ValueChanged.InvokeAsync(_value);
        }
        finally
        {
            _publishing = false;
        }
    }
}
