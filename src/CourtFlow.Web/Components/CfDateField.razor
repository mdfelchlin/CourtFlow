@* A calendar date field over MudBlazor's date picker. Binds DateOnly and accepts typed dates as yyyy-MM-dd. *@
<CfField Label="@Label" Required="Required" LabelId="@labelId" @attributes="AdditionalAttributes">
    <MudDatePicker Date="@ToDateTime(Value)"
                   DateChanged="OnDateChanged"
                   aria-labelledby="@labelId"
                   Variant="CfDefaults.FieldVariant"
                   Margin="CfDefaults.FieldMargin"
                   Required="Required"
                   Disabled="Disabled"
                   Editable="true"
                   DateFormat="@DateFormat"
                   Placeholder="@DateFormat.ToLowerInvariant()" />
</CfField>

@code {
    private const string DateFormat = "yyyy-MM-dd";

    private readonly string labelId = CfIds.Next();

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private static DateTime? ToDateTime(DateOnly? date) =>
        date?.ToDateTime(TimeOnly.MinValue);

    private Task OnDateChanged(DateTime? date) =>
        ValueChanged.InvokeAsync(date is null ? null : DateOnly.FromDateTime(date.Value));
}
