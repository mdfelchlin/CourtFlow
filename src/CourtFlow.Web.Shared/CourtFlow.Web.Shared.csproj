<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NOTE: Microsoft.AspNetCore.Http.Abstractions stays on the legacy 2.3.x line
      ON PURPOSE. ThemeState reads the courtflow-theme cookie via IHttpContextAccessor.
      The shared-framework version of that type (Microsoft.AspNetCore.App, 10.0.0.0) is
      server-only and is NOT present in the WASM runtime, so swapping to a
      FrameworkReference compiles cleanly but blows up when blazor.web.js loads
      CourtFlow.Web.Shared.dll on the client. The 2.3.x package ships a redistributable
      assembly that gets bundled into the WASM payload, which is what we need.
    -->
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CourtFlow.ApiClient\CourtFlow.ApiClient.csproj" />
  </ItemGroup>

</Project>
