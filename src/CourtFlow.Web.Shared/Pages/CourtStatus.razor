@page "/court-status"
@page "/court-status/tv"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Court status · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">@(_tvMode ? "Court status — TV" : "Court status")</MudText>
    @if (!_tvMode)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudToggleGroup T="string" @bind-Value="_viewMode" Color="Color.Primary" Size="Size.Small" CheckMark="true">
                <MudToggleItem Value="@("grid")" Text="Grid" />
                <MudToggleItem Value="@("cards")" Text="Cards" />
            </MudToggleGroup>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tv" Href="@TvHref">TV mode</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="OpenReflowAsync">Reflow</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh" OnClick="ReloadAsync" Disabled="_loading" />
        </MudStack>
    }
</MudStack>

<ReflowPreviewDrawer @ref="_reflow" TournamentId="TournamentStore.SelectedTournamentId" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (TournamentStore.SelectedTournamentId is null)
{
    <MudAlert Severity="Severity.Info">Pick a tournament to see live pacing per court.</MudAlert>
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">No courts found for this tournament.</MudAlert>
}
else if (_viewMode == "grid" || _tvMode)
{
    <div class="@(_tvMode ? "cf-tv-grid" : "")">
        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="true">
            <thead>
                <tr>
                    <th>Court</th><th>Venue</th><th>Status</th><th>Δ min</th><th>Division</th><th>Match</th>
                    @if (!_tvMode) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _items)
                {
                    <tr>
                        <td>@c.CourtName</td>
                        <td>@c.VenueName</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@StatusChipColor(c.Status)">@c.Status</MudChip></td>
                        <td>@c.MinutesBehind</td>
                        <td>@(c.DivisionName ?? "—")</td>
                        <td>@(c.CurrentMatchLabel ?? "—")</td>
                        @if (!_tvMode)
                        {
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.HourglassBottom" Size="Size.Small" aria-label="Delay court" OnClick="@(() => DelayAsync(c))" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>
}
else
{
    <MudGrid>
        @foreach (var c in _items)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@c.CourtName</MudText>
                            <MudText Typo="Typo.caption">@c.VenueName</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Size="Size.Small" Color="@StatusChipColor(c.Status)">@c.Status</MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">@(c.CurrentMatchLabel ?? "Idle")</MudText>
                        <MudText Typo="Typo.caption">@(c.DivisionName ?? "—") · @c.MinutesBehind min</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.HourglassBottom" OnClick="@(() => DelayAsync(c))">Delay</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<style>
    .cf-tv-grid { font-size: 1.1rem; }
    .cf-tv-grid .mud-table-cell { padding: 12px 16px; }
</style>

@code {
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private IReadOnlyList<CourtStatusDto> _items = Array.Empty<CourtStatusDto>();
    private ReflowPreviewDrawer? _reflow;
    private bool _loading = true;
    private bool _tvMode;
    private string _viewMode = "grid";

    private string TvHref => TournamentStore.SelectedTournamentId is { } tid
        ? $"/court-status/tv?tournamentId={tid}"
        : "/court-status/tv";

    protected override async Task OnInitializedAsync()
    {
        _tvMode = Nav.Uri.Contains("/court-status/tv", StringComparison.OrdinalIgnoreCase);
        await TournamentStore.EnsureInitializedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var tid = TournamentStore.SelectedTournamentId;
            if (tid is null) { _items = Array.Empty<CourtStatusDto>(); return; }
            _items = await Api.CourtStatus.GetAsync(tid.Value);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task DelayAsync(CourtStatusDto c)
    {
        var parms = new DialogParameters { ["CourtId"] = c.CourtId, ["CourtName"] = c.CourtName };
        var dialog = await DialogService.ShowAsync<DelayCourtDialog>("Delay court", parms);
        if ((await dialog.Result) is { Canceled: false }) await ReloadAsync();
    }

    private async Task OpenReflowAsync()
    {
        if (_reflow is not null) await _reflow.OpenAsync();
    }

    private static Color StatusChipColor(CourtStatusKindDto k) => k switch
    {
        CourtStatusKindDto.Behind => Color.Error,
        CourtStatusKindDto.SlightlyBehind => Color.Warning,
        CourtStatusKindDto.OnTime => Color.Success,
        CourtStatusKindDto.Ahead => Color.Info,
        _ => Color.Default
    };
}
