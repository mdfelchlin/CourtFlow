@page "/imports"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Imports · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
    <MudText Typo="Typo.h4">Imports</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Info"
                   aria-label="CSV format help"
                   OnClick="OpenFormatHelpAsync"
                   Size="Size.Medium" />
</MudStack>

<MudPaper Class="pa-3 mb-3" Outlined="true">
    <MudStack Spacing="2">
        @if (!string.IsNullOrWhiteSpace(_csv))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @if (_detectedMode == ImportMode.PredefinedPools)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Format: Predefined pools</MudChip>
                }
                else if (_detectedMode == ImportMode.RankedTeams)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Format: Ranked teams</MudChip>
                    <MudSelect T="RankedSeedStrategyDto" @bind-Value="_strategy" Label="Strategy" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="cf-select--md">
                        <MudSelectItem T="RankedSeedStrategyDto" Value="RankedSeedStrategyDto.Snake">Snake</MudSelectItem>
                    </MudSelect>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mud-width-full">
                        <MudText Typo="Typo.body2">
                            Could not detect format from the header row. Expected either a <code>PoolName</code> column (predefined pools) or a <code>Rank</code> column (ranked teams).
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-1" OnClick="OpenFormatHelpAsync">View expected formats</MudButton>
                    </MudAlert>
                }
            </MudStack>
        }

        <MudSwitch T="bool" @bind-Value="_dryRun" Color="Color.Info" Label="Dry run (validate only)" />

        <MudText Typo="Typo.subtitle2">CSV upload</MudText>
        @if (_detectedMode == ImportMode.RankedTeams)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Ranked import auto-builds pools: minimum 3 teams, prefers 4-team pools, and uses one 5-team pool when exactly 5 teams.
            </MudAlert>
        }
        <div class="upload-dropzone @(_dragActive ? "drag-active" : string.Empty)"
             @ondragenter="OnDragEnter"
             @ondragleave="OnDragLeave"
             @ondragover:preventDefault="true"
             @ondrop="OnDrop">
            <InputFile id="import-file-input"
                       class="upload-input"
                       accept=".csv,text/csv"
                       OnChange="OnFilePicked" />
            <div class="upload-copy">
                <MudText Typo="Typo.subtitle2">Drag and drop CSV here</MudText>
                <MudText Typo="Typo.body2" Class="mud-secondary-text">or click to browse</MudText>
                @if (!string.IsNullOrWhiteSpace(_fileName))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mt-2">@_fileName</MudChip>
                }
            </div>
        </div>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton OnClick="PreviewAsync" Variant="Variant.Outlined" Size="Size.Small" Class="cf-toolbar-btn" Disabled="_detectedMode is null">Preview</MudButton>
            <MudButton OnClick="ImportAsync" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="cf-toolbar-btn" Disabled="TournamentStore.SelectedTournamentId is null || _loading || _detectedMode is null">Import</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (_previewErrors.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        <MudText Typo="Typo.subtitle2">Preview errors</MudText>
        <MudList T="string" Dense="true">
            @foreach (var e in _previewErrors)
            {
                <MudListItem T="string">@e</MudListItem>
            }
        </MudList>
    </MudAlert>
}

@if (_detectedMode == ImportMode.RankedTeams && _rankedPoolPreview.Count > 0)
{
    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Ranked pool preview</MudText>
        <MudText Typo="Typo.body2" Class="mud-secondary-text mb-2">Computed from team counts before import.</MudText>
        <MudList T="RankedDivisionPreview" Dense="true">
            @foreach (var p in _rankedPoolPreview)
            {
                <MudListItem T="RankedDivisionPreview" Value="p">
                    @if (p.Error is null)
                    {
                        <MudText Typo="Typo.body2">@p.DivisionName: @p.TeamCount teams -> @string.Join(" / ", p.PoolSizes.Select(s => $"{s}-team"))</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error">@p.DivisionName: @p.Error</MudText>
                    }
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}

@if (_result is not null)
{
    <MudPaper Class="pa-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Import result</MudText>
        <MudText Typo="Typo.body2">Created pools: @_result.CreatedPools</MudText>
        <MudText Typo="Typo.body2">Created teams: @_result.CreatedTeams</MudText>
        <MudText Typo="Typo.body2">Updated teams: @_result.UpdatedTeams</MudText>
        @if (_result.Errors.Count > 0)
        {
            <MudList T="ImportErrorDto" Dense="true">
                @foreach (var e in _result.Errors)
                {
                    <MudListItem T="ImportErrorDto">Row @e.RowNumber: @e.Message</MudListItem>
                }
            </MudList>
        }
    </MudPaper>
}

<style>
    .upload-dropzone {
        position: relative;
        border: 2px dashed var(--mud-palette-lines-default);
        border-radius: 8px;
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--mud-palette-surface);
        transition: border-color 120ms ease, background-color 120ms ease;
    }

    .upload-dropzone.drag-active {
        border-color: var(--mud-palette-primary);
        background: var(--mud-palette-primary-hover);
    }

    .upload-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .upload-copy {
        text-align: center;
        pointer-events: none;
    }
</style>

@code {
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private enum ImportMode { PredefinedPools, RankedTeams }

    private string _csv = string.Empty;
    private bool _dryRun;
    private bool _loading;
    private bool _dragActive;
    private string? _fileName;
    private ImportMode? _detectedMode;
    private RankedSeedStrategyDto _strategy = RankedSeedStrategyDto.Snake;
    private List<string> _previewErrors = new();
    private List<RankedDivisionPreview> _rankedPoolPreview = new();
    private ImportResultDto? _result;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await TournamentStore.EnsureInitializedAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnFilePicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        _csv = await reader.ReadToEndAsync();
        _fileName = file.Name;
        _previewErrors.Clear();
        _rankedPoolPreview.Clear();
        _result = null;
        _detectedMode = DetectImportModeFromCsv(_csv);
    }

    private async Task OpenFormatHelpAsync()
    {
        await DialogService.ShowAsync<ImportFormatHelpDialog>(
            "CSV import formats",
            new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private void OnDragEnter()
    {
        _dragActive = true;
    }

    private void OnDragLeave()
    {
        _dragActive = false;
    }

    private void OnDrop()
    {
        _dragActive = false;
    }

    private Task PreviewAsync()
    {
        if (_detectedMode is null)
        {
            Snackbar.Add("Upload a CSV whose header row includes PoolName or Rank.", Severity.Warning);
            return Task.CompletedTask;
        }

        if (_detectedMode == ImportMode.PredefinedPools)
        {
            _previewErrors = ParsePredefinedRows(_csv).Errors;
            _rankedPoolPreview.Clear();
        }
        else
        {
            var parsed = ParseRankedRows(_csv);
            _previewErrors = parsed.Errors;
            _rankedPoolPreview = _previewErrors.Count == 0
                ? BuildRankedPoolPreview(parsed.Rows)
                : new List<RankedDivisionPreview>();
        }

        if (_previewErrors.Count == 0)
        {
            Snackbar.Add("CSV preview looks valid.", Severity.Success);
        }
        return Task.CompletedTask;
    }

    private async Task ImportAsync()
    {
        if (TournamentStore.SelectedTournamentId is null)
        {
            Snackbar.Add("Select a tournament.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_csv))
        {
            Snackbar.Add("Upload a CSV file first.", Severity.Warning);
            return;
        }
        if (_detectedMode is null)
        {
            Snackbar.Add("Upload a CSV whose header row includes PoolName or Rank.", Severity.Warning);
            return;
        }

        _loading = true;
        _result = null;
        try
        {
            if (_detectedMode == ImportMode.PredefinedPools)
            {
                var parsed = ParsePredefinedRows(_csv);
                _previewErrors = parsed.Errors;
                if (parsed.Errors.Count > 0) return;
                _result = await Api.Imports.ImportPredefinedPoolsAsync(
                    new ImportPredefinedPoolsDto(TournamentStore.SelectedTournamentId.Value, _dryRun, parsed.Rows));
            }
            else
            {
                var parsed = ParseRankedRows(_csv);
                _previewErrors = parsed.Errors;
                _rankedPoolPreview = parsed.Errors.Count == 0
                    ? BuildRankedPoolPreview(parsed.Rows)
                    : new List<RankedDivisionPreview>();
                if (parsed.Errors.Count > 0) return;
                _result = await Api.Imports.ImportRankedTeamsAsync(
                    new ImportRankedTeamsDto(TournamentStore.SelectedTournamentId.Value, _dryRun, _strategy, parsed.Rows));
            }

            Snackbar.Add(_result.Errors.Count == 0 ? "Import complete." : "Import finished with errors.", _result.Errors.Count == 0 ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static (List<PredefinedPoolImportRowDto> Rows, List<string> Errors) ParsePredefinedRows(string csv)
    {
        var rows = new List<PredefinedPoolImportRowDto>();
        var errors = new List<string>();
        var lines = csv.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length < 2)
        {
            errors.Add("CSV must include header and at least one row.");
            return (rows, errors);
        }

        var headers = SplitCsvLine(lines[0]);
        var headerMap = BuildHeaderMap(headers);
        if (!RequireHeaders(headerMap, errors, "DivisionName", "PoolName", "TeamName", "Club", "Wave"))
        {
            return (rows, errors);
        }

        for (var i = 1; i < lines.Length; i++)
        {
            var cols = SplitCsvLine(lines[i]);
            var division = GetValue(cols, headerMap, "DivisionName");
            var pool = GetValue(cols, headerMap, "PoolName");
            var team = GetValue(cols, headerMap, "TeamName");
            var club = GetValue(cols, headerMap, "Club");
            var waveText = GetValue(cols, headerMap, "Wave");
            var seedText = GetValue(cols, headerMap, "SeedHint");

            if (string.IsNullOrWhiteSpace(division) || string.IsNullOrWhiteSpace(pool) || string.IsNullOrWhiteSpace(team))
            {
                errors.Add($"Row {i + 1}: DivisionName, PoolName, and TeamName are required.");
                continue;
            }

            var wave = ParseWave(waveText, i + 1, errors);
            int? seed = null;
            if (!string.IsNullOrWhiteSpace(seedText) && int.TryParse(seedText, out var parsedSeed)) seed = parsedSeed;
            rows.Add(new PredefinedPoolImportRowDto(i + 1, division, pool, team, NullIfBlank(club), wave, seed));
        }

        return (rows, errors);
    }

    private static (List<RankedTeamImportRowDto> Rows, List<string> Errors) ParseRankedRows(string csv)
    {
        var rows = new List<RankedTeamImportRowDto>();
        var errors = new List<string>();
        var lines = csv.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length < 2)
        {
            errors.Add("CSV must include header and at least one row.");
            return (rows, errors);
        }

        var headers = SplitCsvLine(lines[0]);
        var headerMap = BuildHeaderMap(headers);
        if (!RequireHeaders(headerMap, errors, "DivisionName", "Rank", "TeamName", "Club", "Wave"))
        {
            return (rows, errors);
        }

        for (var i = 1; i < lines.Length; i++)
        {
            var cols = SplitCsvLine(lines[i]);
            var division = GetValue(cols, headerMap, "DivisionName");
            var rankText = GetValue(cols, headerMap, "Rank");
            var team = GetValue(cols, headerMap, "TeamName");
            var club = GetValue(cols, headerMap, "Club");
            var waveText = GetValue(cols, headerMap, "Wave");

            if (string.IsNullOrWhiteSpace(division) || string.IsNullOrWhiteSpace(team))
            {
                errors.Add($"Row {i + 1}: DivisionName and TeamName are required.");
                continue;
            }

            if (!int.TryParse(rankText, out var rank))
            {
                errors.Add($"Row {i + 1}: Rank must be a number.");
                continue;
            }
            var wave = ParseWave(waveText, i + 1, errors);
            rows.Add(new RankedTeamImportRowDto(i + 1, division, rank, team, NullIfBlank(club), wave));
        }

        return (rows, errors);
    }

    private static string[] SplitCsvLine(string line) =>
        line.Split(',').Select(x => x.Trim()).ToArray();

    private static WaveDto ParseWave(string value, int row, List<string> errors)
    {
        var normalized = value?.Trim() ?? string.Empty;
        if (string.Equals(normalized, "AM", StringComparison.OrdinalIgnoreCase) || normalized == "1") return WaveDto.AM;
        if (string.Equals(normalized, "PM", StringComparison.OrdinalIgnoreCase) || normalized == "2") return WaveDto.PM;
        errors.Add($"Row {row}: Wave must be AM or PM (or 1/2).");
        return WaveDto.AM;
    }

    private static string? NullIfBlank(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value;

    private static Dictionary<string, int> BuildHeaderMap(string[] headers)
    {
        var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < headers.Length; i++)
        {
            var key = headers[i].Trim().Trim('"').Replace(" ", string.Empty);
            if (!map.ContainsKey(key))
            {
                map[key] = i;
            }
        }
        return map;
    }

    private static ImportMode? DetectImportModeFromCsv(string csv)
    {
        if (string.IsNullOrWhiteSpace(csv)) return null;
        var lines = csv.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length == 0) return null;
        var headers = SplitCsvLine(lines[0]);
        var headerMap = BuildHeaderMap(headers);
        if (headerMap.ContainsKey("PoolName")) return ImportMode.PredefinedPools;
        if (headerMap.ContainsKey("Rank")) return ImportMode.RankedTeams;
        return null;
    }

    private static bool RequireHeaders(Dictionary<string, int> headers, List<string> errors, params string[] required)
    {
        var missing = required.Where(h => !headers.ContainsKey(h.Replace(" ", string.Empty))).ToList();
        if (missing.Count == 0) return true;
        errors.Add($"Missing required header(s): {string.Join(", ", missing)}.");
        return false;
    }

    private static string GetValue(string[] cols, Dictionary<string, int> headerMap, string headerName)
    {
        var key = headerName.Replace(" ", string.Empty);
        if (!headerMap.TryGetValue(key, out var idx)) return string.Empty;
        return idx >= 0 && idx < cols.Length ? cols[idx].Trim() : string.Empty;
    }

    private static List<RankedDivisionPreview> BuildRankedPoolPreview(IReadOnlyList<RankedTeamImportRowDto> rows)
    {
        var previews = new List<RankedDivisionPreview>();
        foreach (var group in rows.GroupBy(r => r.DivisionName, StringComparer.OrdinalIgnoreCase).OrderBy(g => g.Key))
        {
            var sizes = BuildPoolSizes(group.Count());
            if (sizes.Count == 0)
            {
                previews.Add(new RankedDivisionPreview(group.Key, group.Count(), Array.Empty<int>(), "minimum is 3 teams"));
                continue;
            }

            previews.Add(new RankedDivisionPreview(group.Key, group.Count(), sizes, null));
        }

        return previews;
    }

    private static IReadOnlyList<int> BuildPoolSizes(int teamCount)
    {
        if (teamCount < 3) return Array.Empty<int>();
        if (teamCount == 5) return new[] { 5 };

        for (var poolsOfFour = teamCount / 4; poolsOfFour >= 0; poolsOfFour--)
        {
            var remainder = teamCount - (poolsOfFour * 4);
            if (remainder % 3 != 0) continue;
            var poolsOfThree = remainder / 3;
            var result = new List<int>(poolsOfFour + poolsOfThree);
            for (var i = 0; i < poolsOfFour; i++) result.Add(4);
            for (var i = 0; i < poolsOfThree; i++) result.Add(3);
            return result;
        }

        return Array.Empty<int>();
    }

    private sealed record RankedDivisionPreview(string DivisionName, int TeamCount, IReadOnlyList<int> PoolSizes, string? Error);
}
