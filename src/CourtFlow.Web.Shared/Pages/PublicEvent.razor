@page "/events/{Id:guid}"
@attribute [AllowAnonymous]
@layout PublicLayout
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>@(_event?.Name ?? "Event") · CourtFlow</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_event is null)
{
    <MudPaper Class="pa-8" Outlined="true">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">Event not found</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/">Back to events</MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudStack Spacing="4">
        <MudBreadcrumbs Items="_crumbs" />

        <MudPaper Elevation="0" Class="pa-6" Outlined="true">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudText Typo="Typo.h4">@_event.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor" Variant="Variant.Filled">@StatusLabel</MudChip>
                </MudStack>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@_event.OrganizationName</MudText>
                <MudText Typo="Typo.body2">@FormatDates(_event.StartDate, _event.EndDate)</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Outlined="true" Class="@($"pa-3 cf-my-team-strip{(_stickyStrip ? " cf-my-team-sticky" : "")}")">
            @if (_pinnedTeam is null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                    <MudText Typo="Typo.caption">Filter to my team</MudText>
                    <MudAutocomplete T="PublicTeamOption"
                                       Placeholder="Type your team or club name"
                                       SearchFunc="SearchTeams"
                                       ToStringFunc="@(t => t?.Label ?? "")"
                                       Value="_pinnedTeam"
                                       ValueChanged="PinTeamAsync"
                                       Clearable="true"
                                       Dense="true"
                                       Style="flex:1; min-width:200px;" />
                </MudStack>
            }
            else
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
                    <MudStack Spacing="0" Style="min-width:140px;">
                        <MudText Typo="Typo.subtitle1" Style="font-size:14pt;">@_pinnedTeam.TeamName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_pinnedTeam.DivisionName</MudText>
                    </MudStack>
                    <MudPaper Outlined="true" Class="pa-2 flex-grow-1" Style="min-width:180px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Next match</MudText>
                        @if (_readiness?.ScheduleReady != true)
                        {
                            <MudText Typo="Typo.body2" Style="font-size:14pt;">Schedule not posted yet</MudText>
                        }
                        else if (_nextMatch is null)
                        {
                            <MudText Typo="Typo.body2" Style="font-size:14pt;">No upcoming matches</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="font-size:14pt;">
                                <span style="@HighlightSide(_nextMatch)">@(_nextMatch.HomeTeamName ?? "TBD") vs @(_nextMatch.AwayTeamName ?? "TBD")</span>
                            </MudText>
                            <MudText Typo="Typo.caption">@_nextMatch.ScheduledStartUtc.ToLocalTime():g · @(_nextMatch.CourtName ?? "TBD")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@NextMatchChipColor(_nextMatch)" Class="mt-1">@NextMatchStatusLabel(_nextMatch)</MudChip>
                        }
                    </MudPaper>
                    <MudPaper Outlined="true" Class="pa-2 flex-grow-1" Style="min-width:180px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Working next</MudText>
                        @if (_readiness?.ScheduleReady != true)
                        {
                            <MudText Typo="Typo.body2" Style="font-size:14pt;">Schedule not posted yet</MudText>
                        }
                        else if (_workingNext is null)
                        {
                            <MudText Typo="Typo.body2" Style="font-size:14pt;">No reffing duty scheduled</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="font-size:14pt;">Reffing on @(_workingNext.CourtName ?? "TBD")</MudText>
                            <MudText Typo="Typo.caption">@_workingNext.ScheduledStartUtc.ToLocalTime():g · @(_workingNext.HomeTeamName ?? "TBD") vs @(_workingNext.AwayTeamName ?? "TBD")</MudText>
                        }
                    </MudPaper>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearPin">Change team</MudButton>
                </MudStack>
            }
        </MudPaper>

        <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" ActivePanelIndex="_tabIndex" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="Teams" Icon="@Icons.Material.Filled.Groups" PanelClass="pa-4">
                @if (_teamsLoading) { <MudProgressLinear Indeterminate="true" /> }
                else if (_readiness?.TeamsReady != true) { <MudAlert Severity="Severity.Info">Teams haven't been posted for this event yet.</MudAlert> }
                else if (_teams is null || _teams.Count == 0) { <MudAlert Severity="Severity.Info">No teams listed.</MudAlert> }
                else { @foreach (var div in OrderedDivisions()) {
                    var pinned = _pinnedTeam?.DivisionId == div.DivisionId;
                    <MudPaper Outlined="true" Class="@($"pa-4 mb-3{(pinned ? " mud-border-primary" : "")}")">
                        <MudText Typo="Typo.h6" Class="mb-2">@div.DivisionName @if (pinned) { <MudChip T="string" Size="Size.Small" Color="Color.Primary">Your division</MudChip> }</MudText>
                        <MudTable Items="div.Teams" Dense="true">
                            <HeaderContent><MudTh>Team</MudTh><MudTh>Pool</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd Style="@PinnedRowStyle(context.TeamId)">@context.TeamName</MudTd>
                                <MudTd>@(context.PoolName ?? "—")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                } }
            </MudTabPanel>
            <MudTabPanel Text="Schedule" Icon="@Icons.Material.Filled.CalendarViewWeek" PanelClass="pa-4">
                @if (_scheduleLoading) { <MudProgressLinear Indeterminate="true" /> }
                else if (_readiness?.ScheduleReady != true) { <MudAlert Severity="Severity.Info">Schedule hasn't been published yet.</MudAlert> }
                else if (FilteredSchedule().Count == 0) { <MudAlert Severity="Severity.Info">No scheduled matches.</MudAlert> }
                else {
                    @if (_pinnedTeam is not null && _scheduleFilterActive) {
                        <MudChip T="string" Size="Size.Small" Class="mb-2" OnClick="ShowAllSchedule" Style="cursor:pointer;">
                            Showing @FilteredSchedule().Count of @(_schedule?.Count ?? 0) matches for @_pinnedTeam.Label · Show all
                        </MudChip>
                    }
                    <MudTable Items="@(_scheduleFilterActive ? FilteredSchedule() : _schedule ?? Array.Empty<CourtFlow.ApiClient.PublicMatchDto>())" Dense="true" Hover="true">
                        <HeaderContent><MudTh>Time</MudTh><MudTh>Court</MudTh><MudTh>Match</MudTh><MudTh>State</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ScheduledStartUtc.ToLocalTime().ToString("MMM d · HH:mm")</MudTd>
                            <MudTd>@(context.CourtName ?? "-")</MudTd>
                            <MudTd>@(context.HomeTeamName ?? "TBD") vs @(context.AwayTeamName ?? "TBD")</MudTd>
                            <MudTd>@context.State</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
            <MudTabPanel Text="Brackets" Icon="@Icons.Material.Filled.AccountTree" PanelClass="pa-4">
                @if (_bracketsLoading) { <MudProgressLinear Indeterminate="true" /> }
                else if (_readiness?.BracketsReady != true) { <MudAlert Severity="Severity.Info">No brackets have been generated for this event yet.</MudAlert> }
                else if (_brackets is null || _brackets.Count == 0) { <MudAlert Severity="Severity.Info">No brackets.</MudAlert> }
                else { @foreach (var b in _brackets) {
                    <MudPaper Outlined="true" Class="pa-4 mb-3">
                        <MudText Typo="Typo.h6">@b.DivisionName · @b.Type (@b.TeamCapacity teams)</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@b.Nodes.Count bracket nodes</MudText>
                    </MudPaper>
                } }
            </MudTabPanel>
            <MudTabPanel Text="Standings" Icon="@Icons.Material.Filled.Leaderboard" PanelClass="pa-4">
                @if (_standingsLoading) { <MudProgressLinear Indeterminate="true" /> }
                else if (_readiness?.StandingsReady != true) { <MudAlert Severity="Severity.Info">Standings appear once pool matches are scored.</MudAlert> }
                else if (_standings is null || _standings.Count == 0) { <MudAlert Severity="Severity.Info">No standings yet.</MudAlert> }
                else { @foreach (var pool in OrderedStandings()) {
                    <MudPaper Outlined="true" Class="pa-4 mb-3">
                        <MudText Typo="Typo.h6">@pool.DivisionName · Pool @pool.PoolName</MudText>
                        <MudTable Items="pool.Rows" Dense="true">
                            <HeaderContent><MudTh>#</MudTh><MudTh>Team</MudTh><MudTh>W-L</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Rank</MudTd>
                                <MudTd Style="@PinnedRowStyle(context.TeamId)">@context.TeamName</MudTd>
                                <MudTd>@context.MatchWins-@context.MatchLosses</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                } }
            </MudTabPanel>
        </MudTabs>
    </MudStack>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CourtFlow.ApiClient.PublicEventDetailDto? _event;
    private CourtFlow.ApiClient.PublicEventReadinessDto? _readiness;
    private bool _loading = true;
    private int _tabIndex;

    private IReadOnlyList<CourtFlow.ApiClient.PublicDivisionTeamsDto>? _teams;
    private IReadOnlyList<CourtFlow.ApiClient.PublicMatchDto>? _schedule;
    private IReadOnlyList<CourtFlow.ApiClient.PublicBracketDto>? _brackets;
    private IReadOnlyList<CourtFlow.ApiClient.PublicPoolStandingsDto>? _standings;
    private bool _teamsLoading, _scheduleLoading, _bracketsLoading, _standingsLoading;

    private PublicTeamOption? _pinnedTeam;
    private CourtFlow.ApiClient.PublicMatchDto? _nextMatch;
    private CourtFlow.ApiClient.PublicMatchDto? _workingNext;
    private bool _scheduleFilterActive = true;
    private bool _stickyStrip = true;
    private List<BreadcrumbItem> _crumbs = new();
    private List<PublicTeamOption> _teamOptions = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _event = await Api.PublicEvents.GetAsync(Id);
            _readiness = await Api.PublicEvents.GetReadinessAsync(Id);
        }
        catch { _event = null; }
        finally { _loading = false; }

        if (_event is not null)
        {
            _crumbs = new() { new("Events", href: "/"), new(_event.Name, href: null, disabled: true) };
            await LoadTeamsAsync();
            await RestorePinAsync();
        }
    }

    private IEnumerable<CourtFlow.ApiClient.PublicDivisionTeamsDto> OrderedDivisions()
    {
        if (_teams is null) yield break;
        var pinnedDiv = _pinnedTeam?.DivisionId;
        foreach (var d in _teams.OrderByDescending(d => d.DivisionId == pinnedDiv))
            yield return d;
    }

    private IReadOnlyList<CourtFlow.ApiClient.PublicMatchDto> FilteredSchedule()
    {
        var list = _schedule ?? Array.Empty<CourtFlow.ApiClient.PublicMatchDto>();
        if (_pinnedTeam is null) return list;
        return list.Where(m =>
            m.HomeTeamId == _pinnedTeam.TeamId ||
            m.AwayTeamId == _pinnedTeam.TeamId ||
            m.RefTeamId == _pinnedTeam.TeamId).ToList();
    }

    private async Task LoadTeamsAsync()
    {
        if (_teams is not null || _teamsLoading) return;
        _teamsLoading = true;
        try
        {
            _teams = await Api.PublicEvents.GetTeamsAsync(Id);
            _teamOptions = _teams?.SelectMany(d => d.Teams.Select(t => new PublicTeamOption(t.TeamId, t.TeamName, d.DivisionId, d.DivisionName, $"{t.TeamName} ({d.DivisionName})"))).ToList() ?? new();
        }
        catch { _teams = Array.Empty<CourtFlow.ApiClient.PublicDivisionTeamsDto>(); }
        finally { _teamsLoading = false; }
    }

    private async Task LoadScheduleAsync()
    {
        if (_schedule is not null || _scheduleLoading) return;
        _scheduleLoading = true;
        try { _schedule = await Api.PublicEvents.GetScheduleAsync(Id); UpdateNextAndWorking(); }
        catch { _schedule = Array.Empty<CourtFlow.ApiClient.PublicMatchDto>(); }
        finally { _scheduleLoading = false; }
    }

    private async Task LoadBracketsAsync()
    {
        if (_brackets is not null || _bracketsLoading) return;
        _bracketsLoading = true;
        try { _brackets = await Api.PublicEvents.GetBracketsAsync(Id); }
        catch { _brackets = Array.Empty<CourtFlow.ApiClient.PublicBracketDto>(); }
        finally { _bracketsLoading = false; }
    }

    private async Task LoadStandingsAsync()
    {
        if (_standings is not null || _standingsLoading) return;
        _standingsLoading = true;
        try { _standings = await Api.PublicEvents.GetStandingsAsync(Id); }
        catch { _standings = Array.Empty<CourtFlow.ApiClient.PublicPoolStandingsDto>(); }
        finally { _standingsLoading = false; }
    }

    private async Task OnTabChanged(int index)
    {
        _tabIndex = index;
        switch (index)
        {
            case 0: await LoadTeamsAsync(); break;
            case 1: await LoadScheduleAsync(); break;
            case 2: await LoadBracketsAsync(); break;
            case 3: await LoadStandingsAsync(); break;
        }
    }

    private Task<IEnumerable<PublicTeamOption>> SearchTeams(string value, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult(_teamOptions.Take(50).AsEnumerable());
        return Task.FromResult(_teamOptions.Where(t => t.Label.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(50));
    }

    private async Task PinTeamAsync(PublicTeamOption? team)
    {
        _pinnedTeam = team;
        _scheduleFilterActive = team is not null;
        if (_schedule is null && team is not null)
            await LoadScheduleAsync();
        UpdateNextAndWorking();
        if (team is not null)
            await Js.InvokeVoidAsync("localStorage.setItem", $"courtflow.publicMyTeam.{Id}", team.TeamId.ToString());
        else
            await Js.InvokeVoidAsync("localStorage.removeItem", $"courtflow.publicMyTeam.{Id}");
    }

    private async Task RestorePinAsync()
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", $"courtflow.publicMyTeam.{Id}");
            if (Guid.TryParse(raw, out var teamId))
            {
                _pinnedTeam = _teamOptions.FirstOrDefault(t => t.TeamId == teamId);
                if (_pinnedTeam is not null)
                    await LoadScheduleAsync();
            }
        }
        catch { /* no JS on prerender */ }
        UpdateNextAndWorking();
    }

    private void ClearPin() => _ = PinTeamAsync(null);

    private void ShowAllSchedule() => _scheduleFilterActive = false;

    private void UpdateNextAndWorking()
    {
        if (_pinnedTeam is null)
        {
            _nextMatch = null;
            _workingNext = null;
            return;
        }

        var now = DateTime.UtcNow;
        var teamMatches = (_schedule ?? Array.Empty<CourtFlow.ApiClient.PublicMatchDto>())
            .Where(m =>
                m.HomeTeamId == _pinnedTeam.TeamId ||
                m.AwayTeamId == _pinnedTeam.TeamId ||
                m.RefTeamId == _pinnedTeam.TeamId)
            .ToList();

        _nextMatch = teamMatches
            .Where(m => (m.HomeTeamId == _pinnedTeam.TeamId || m.AwayTeamId == _pinnedTeam.TeamId)
                        && m.State != CourtFlow.ApiClient.MatchStateDto.Final)
            .OrderBy(m => m.ScheduledStartUtc)
            .FirstOrDefault(m => m.ScheduledStartUtc >= now.AddHours(-2));

        _workingNext = teamMatches
            .Where(m => m.RefTeamId == _pinnedTeam.TeamId && m.State != CourtFlow.ApiClient.MatchStateDto.Final)
            .OrderBy(m => m.ScheduledStartUtc)
            .FirstOrDefault(m => m.ScheduledStartUtc >= now.AddHours(-2));
    }

    private IEnumerable<CourtFlow.ApiClient.PublicPoolStandingsDto> OrderedStandings()
    {
        if (_standings is null) yield break;
        var pinnedDiv = _pinnedTeam?.DivisionId;
        foreach (var p in _standings.OrderByDescending(s => s.DivisionId == pinnedDiv))
            yield return p;
    }

    private string? PinnedRowStyle(Guid teamId) =>
        _pinnedTeam?.TeamId == teamId ? "font-weight:700;" : null;

    private string HighlightSide(CourtFlow.ApiClient.PublicMatchDto match)
    {
        if (_pinnedTeam is null) return "";
        if (match.HomeTeamId == _pinnedTeam.TeamId || match.AwayTeamId == _pinnedTeam.TeamId)
            return "font-weight:700;";
        return "";
    }

    private static string NextMatchStatusLabel(CourtFlow.ApiClient.PublicMatchDto match) => match.State switch
    {
        CourtFlow.ApiClient.MatchStateDto.InProgress => "Live now",
        CourtFlow.ApiClient.MatchStateDto.Final => "Final",
        _ when match.ScheduledStartUtc <= DateTime.UtcNow => "Live now",
        _ => "Upcoming"
    };

    private static Color NextMatchChipColor(CourtFlow.ApiClient.PublicMatchDto match) => match.State switch
    {
        CourtFlow.ApiClient.MatchStateDto.InProgress => Color.Success,
        CourtFlow.ApiClient.MatchStateDto.Final => Color.Default,
        _ when match.ScheduledStartUtc <= DateTime.UtcNow => Color.Success,
        _ => Color.Info
    };

    private string StatusLabel
    {
        get
        {
            if (_event is null) return "";
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            if (today < _event.StartDate) return "Upcoming";
            if (today > _event.EndDate) return "Completed";
            return "Live";
        }
    }

    private Color StatusColor => StatusLabel switch { "Live" => Color.Success, "Upcoming" => Color.Info, _ => Color.Default };

    private static string FormatDates(DateOnly start, DateOnly end) =>
        start == end ? start.ToString("MMM d, yyyy") : $"{start:MMM d} – {end:MMM d, yyyy}";

    private sealed record PublicTeamOption(Guid TeamId, string TeamName, Guid DivisionId, string DivisionName, string Label);
}

<style>
    @@media (min-width: 600px) {
        .cf-my-team-sticky {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--mud-palette-background);
        }
    }
</style>
