@page "/teams"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SelectedTournamentStore TournamentStore
@implements IDisposable

<PageTitle>Teams · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudText Typo="Typo.h4">Teams</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudSelect T="Guid?" @bind-Value="_divisionId" Label="Division" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="cf-select--sm" @bind-Value:after="OnDivisionChanged"
                   ToStringFunc="_divisionName">
            @foreach (var d in _divisions)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)d.Id)">@d.Name</MudSelectItem>
            }
        </MudSelect>
        <CfToolbarAddButton OnClick="NewAsync" Disabled="_divisionId is null" AriaLabel="Add team" />
    </MudStack>
</MudStack>

<MudDataGrid T="TeamDto" Items="_items" Loading="_loading" Dense="true" Hover="true">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Club" Title="Club" />
        <PropertyColumn Property="x => x.Wave" Title="Wave" />
        <TemplateColumn Title="Pool">
            <CellTemplate>@(_pools.FirstOrDefault(p => p.Id == context.Item.PoolId)?.Name ?? "-")</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.SeedHint" Title="Seed hint" />
        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private IReadOnlyList<DivisionDto> _divisions = Array.Empty<DivisionDto>();
    private IReadOnlyList<PoolDto> _pools = Array.Empty<PoolDto>();
    private IReadOnlyList<TeamDto> _items = Array.Empty<TeamDto>();
    private Guid? _divisionId;
    private bool _loading = true;

    private Func<Guid?, string> _divisionName =>
        id => id is null ? string.Empty
            : _divisions.FirstOrDefault(d => d.Id == id)?.Name ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        TournamentStore.Changed += OnTournamentStoreChanged;
        try
        {
            await TournamentStore.EnsureInitializedAsync();
            await OnTournamentChanged();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _loading = false; }
    }

    private void OnTournamentStoreChanged() => _ = InvokeAsync(async () => await OnTournamentChanged());

    private async Task OnTournamentChanged()
    {
        var tid = TournamentStore.SelectedTournamentId;
        _divisions = tid is null ? Array.Empty<DivisionDto>() : await Api.Divisions.ListAsync(tid);
        _divisionId = _divisions.Count > 0 ? _divisions[0].Id : null;
        await OnDivisionChanged();
    }

    private async Task OnDivisionChanged()
    {
        _pools = _divisionId is null ? Array.Empty<PoolDto>() : await Api.Pools.ListAsync(_divisionId);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _items = _divisionId is null ? Array.Empty<TeamDto>() : await Api.Teams.ListAsync(_divisionId); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private async Task NewAsync()
    {
        if (_divisionId is null) return;
        var parms = new DialogParameters { ["DivisionId"] = _divisionId.Value, ["Pools"] = _pools };
        var dialog = await DialogService.ShowAsync<TeamDialog>("New team", parms);
        if ((await dialog.Result) is { Canceled: false }) await ReloadAsync();
    }

    private async Task EditAsync(TeamDto t)
    {
        var parms = new DialogParameters { ["Existing"] = t, ["DivisionId"] = t.DivisionId, ["Pools"] = _pools };
        var dialog = await DialogService.ShowAsync<TeamDialog>("Edit team", parms);
        if ((await dialog.Result) is { Canceled: false }) await ReloadAsync();
    }

    private async Task DeleteAsync(TeamDto t)
    {
        var ok = await DialogService.ShowMessageBox("Delete team", $"Delete '{t.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try { await Api.Teams.DeleteAsync(t.Id); Snackbar.Add("Deleted", Severity.Success); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    public void Dispose() => TournamentStore.Changed -= OnTournamentStoreChanged;
}
