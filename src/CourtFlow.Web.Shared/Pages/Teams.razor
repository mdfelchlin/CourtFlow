@page "/teams"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Teams · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudText Typo="Typo.h4">Teams</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <MudTooltip Text="Reload teams from server">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Default"
                           Size="Size.Medium"
                           Disabled="_loading || TournamentStore.SelectedTournamentId is null"
                           OnClick="ReloadAsync"
                           aria-label="Refresh teams" />
        </MudTooltip>
        <CfToolbarAddButton OnClick="NewAsync" Disabled="_divisions.Count == 0" AriaLabel="Add team" />
    </MudStack>
</MudStack>

<MudGrid Spacing="2" Class="mb-3 cf-teams-filters">
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="Guid?" @bind-Value="_filterDivisionId"
                   Label="Division"
                   Dense="true"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   Class="cf-teams-filter-control cf-select--sm"
                   Clearable="true"
                   Placeholder="All divisions"
                   ToStringFunc="_filterDivisionLabel">
            @foreach (var d in _divisions)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)d.Id)">@d.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField @bind-Value="_filterName"
                      Label="Team"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="cf-teams-filter-control cf-teams-filter-name"
                      Immediate="true"
                      InputType="InputType.Text"
                      Lines="1"
                      Clearable="true" />
    </MudItem>
    <MudItem xs="12" sm="12" md="4">
        <MudAutocomplete T="string"
                         @bind-Value="_filterClubText"
                         Label="Club"
                         Dense="true"
                         Margin="Margin.Dense"
                         Variant="Variant.Outlined"
                         FullWidth="true"
                         Class="cf-teams-filter-control cf-select--sm"
                         Clearable="true"
                         Strict="false"
                         CoerceText="true"
                         ResetValueOnEmptyText="true"
                         Placeholder="Type to search clubs"
                         MaxItems="25"
                         SearchFunc="SearchClubFilterAsync" />
    </MudItem>
</MudGrid>

<MudDataGrid T="TeamDto" Items="FilteredItems" Loading="_loading" Dense="true" Hover="true" Class="cf-teams-grid">
    <Columns>
        <TemplateColumn Title="Division">
            <CellTemplate>@(_divisions.FirstOrDefault(d => d.Id == context.Item.DivisionId)?.Name ?? "-")</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Name" Title="Team" />
        <PropertyColumn Property="x => x.Club" Title="Club" />
        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context.Item))" aria-label="Edit" />
                @if (context.Item.TournamentTeamId is { } ttId)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" Color="Color.Warning"
                                   aria-label="Withdraw from tournament"
                                   OnClick="@(() => WithdrawAsync(context.Item, ttId))" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Item))" aria-label="Delete" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private IReadOnlyList<DivisionDto> _divisions = Array.Empty<DivisionDto>();
    private List<TeamDto> _items = new();
    private Guid? _filterDivisionId;
    private string? _filterName = "";
    private string? _filterClubText = "";
    private bool _loading = true;

    private IReadOnlyList<TeamDto> FilteredItems
    {
        get
        {
            IEnumerable<TeamDto> q = _items;
            if (_filterDivisionId is { } fd) q = q.Where(t => t.DivisionId == fd);
            var name = (_filterName ?? "").Trim();
            if (name.Length > 0) q = q.Where(t => t.Name.Contains(name, StringComparison.OrdinalIgnoreCase));
            var club = (_filterClubText ?? "").Trim();
            if (club.Length > 0)
                q = q.Where(t => t.Club is not null && t.Club.Contains(club, StringComparison.OrdinalIgnoreCase));
            return q.ToList();
        }
    }

    private Func<Guid?, string> _filterDivisionLabel =>
        id => id is null ? "" : _divisions.FirstOrDefault(d => d.Id == id)?.Name ?? "";

    private Task<IEnumerable<string>> SearchClubFilterAsync(string value, CancellationToken ct)
    {
        var opts = ClubFilterOptions;
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<string>>(opts);
        var v = value.Trim();
        return Task.FromResult<IEnumerable<string>>(
            opts.Where(c => c.Contains(v, StringComparison.OrdinalIgnoreCase)));
    }

    private IReadOnlyList<string> ClubFilterOptions =>
        _items
            .Select(t => t.Club)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await TournamentStore.EnsureInitializedAsync();
            await OnTournamentChanged();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _loading = false; }
    }

    private async Task OnTournamentChanged()
    {
        var tid = TournamentStore.SelectedTournamentId;
        _divisions = tid is null ? Array.Empty<DivisionDto>() : await Api.Divisions.ListAsync(tid);
        _filterDivisionId = null;
        _filterName = "";
        _filterClubText = "";
        await ReloadAsync();
    }

    /// <summary>Loads teams from the API. Call on page/tournament load and when the user clicks Refresh — not after every edit.</summary>
    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var tid = TournamentStore.SelectedTournamentId;
            _items = tid is null ? new List<TeamDto>() : (await Api.Teams.ListAsync(tournamentId: tid.Value)).ToList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private void UpsertLocal(TeamDto t)
    {
        var i = _items.FindIndex(x => x.Id == t.Id);
        if (i >= 0) _items[i] = t;
        else _items.Add(t);
        _items.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Distinct club names already used in this tournament, plus the edited team&apos;s club if any.</summary>
    private IReadOnlyList<string> BuildClubOptions(TeamDto? existing)
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var x in _items)
        {
            if (!string.IsNullOrWhiteSpace(x.Club))
                set.Add(x.Club.Trim());
        }
        if (existing?.Club is { } ec && !string.IsNullOrWhiteSpace(ec))
            set.Add(ec.Trim());
        return set.OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private async Task NewAsync()
    {
        if (_divisions.Count == 0) return;
        var initial = _filterDivisionId ?? _divisions[0].Id;
        var parms = new DialogParameters
        {
            ["Divisions"] = _divisions,
            ["InitialDivisionId"] = initial,
            ["ClubOptions"] = BuildClubOptions(null),
        };
        var dialog = await DialogService.ShowAsync<TeamDialog>("New team", parms, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var r = await dialog.Result;
        if (r is { Canceled: false } && r.Data is TeamDto saved) UpsertLocal(saved);
    }

    private async Task EditAsync(TeamDto t)
    {
        var parms = new DialogParameters
        {
            ["Existing"] = t,
            ["Divisions"] = _divisions,
            ["ClubOptions"] = BuildClubOptions(t),
        };
        var dialog = await DialogService.ShowAsync<TeamDialog>("Edit team", parms, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var r = await dialog.Result;
        if (r is { Canceled: false } && r.Data is TeamDto saved) UpsertLocal(saved);
    }

    private async Task DeleteAsync(TeamDto t)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete team", $"Delete '{t.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await Api.Teams.DeleteAsync(t.Id);
            Snackbar.Add("Deleted", Severity.Success);
            _items.RemoveAll(x => x.Id == t.Id);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task WithdrawAsync(TeamDto t, Guid tournamentTeamId)
    {
        var tid = TournamentStore.SelectedTournamentId;
        if (tid is null) return;
        var parms = new DialogParameters { ["TournamentId"] = tid.Value };
        var dialog = await DialogService.ShowAsync<WithdrawTeamDialog>("Withdraw team", parms);
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add("Withdrawal recorded", Severity.Success);
            await ReloadAsync();
        }
    }

}
