        _materializeBusy = true;
        try
        {
            SyncBracketTeamCountsFromRules();
            await SaveBracketStructureAsync(silent: true);
            await SaveAdvancementRulesAsync(silent: true);
            await Api.Divisions.GenerateBracketsAsync(DivisionId);
