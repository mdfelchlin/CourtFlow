    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = "Gold";
        public int TeamCount { get; set; } = 8;
        public BracketTypeDto Type { get; set; } = BracketTypeDto.SingleElimination;
        public bool IfNecessaryFinal { get; set; }
        public int Sequence { get; set; }
    }

    private sealed class EditableRule
    {
        public Guid? Id { get; set; }
        public Guid? SourcePoolId { get; set; }
        public int SourceFinishPosition { get; set; } = 1;
        public string TargetBracketName { get; set; } = "Gold";
        public int TargetSeedSlot { get; set; } = 1;
        public string OrderBy { get; set; } = "pool_sequence";
