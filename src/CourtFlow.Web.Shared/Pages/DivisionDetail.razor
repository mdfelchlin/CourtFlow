    private string SnakePrerequisiteHint
    {
        get
        {
            if (_poolDraft.Any(p => p.Id == Guid.Empty))
                return "Save pool structure in Step 2 (all pools need saved IDs) before snaking.";
            if (!PoolsMatchSuggestedLayout && _suggestedPoolSizes.Count > 0)
                return $"Use {_suggestedPoolSizes.Count} pool(s) for {_teams.Count} teams (Step 2 → Apply suggested layout), then Save pools.";
            if (_teams.Count < 3)
                return "At least 3 teams are required in this division.";
            return "Complete Step 2 pool structure before snaking.";
        }
    }

    private async Task ApplySuggestedPoolsAsync()
    {
        var sizes = _suggestedPoolSizes;
        if (sizes.Count == 0) return;

        _poolDraft = sizes
            .Select((size, i) => new EditablePool
            {
                Name = $"Pool {(char)('A' + i)}",
                TargetSize = size,
                Sequence = i
            })
            .ToList();

        await SavePoolStructureAsync();
    }

    private Task AddPoolDraftAsync()
    {
        var letter = (char)('A' + _poolDraft.Count);
        _poolDraft.Add(new EditablePool { Name = $"Pool {letter}", TargetSize = 4, Sequence = _poolDraft.Count });
        return Task.CompletedTask;
    }

    private void AddBracketDraft() =>
        _bracketDraft.Add(new EditableBracket { Name = $"Bracket {_bracketDraft.Count + 1}", TeamCount = 8, Type = BracketTypeDto.SingleElimination, Sequence = _bracketDraft.Count });

    private void AddRuleDraft() =>
        _ruleDraft.Add(new EditableRule { SourceFinishPosition = 1, TargetBracketName = _bracketDraft.FirstOrDefault()?.Name ?? "Gold", TargetSeedSlot = 1, OrderBy = "pool_sequence" });

    private void RemoveRule(EditableRule rule) => _ruleDraft.Remove(rule);

    private void ApplyTopNPreset(int topN)
    {
        _ruleDraft.Clear();
        var gold = _bracketDraft.FirstOrDefault(b => b.Name.Equals("Gold", StringComparison.OrdinalIgnoreCase)) ?? _bracketDraft.FirstOrDefault();
        if (gold is null) return;

        var poolCount = Math.Max(1, _poolDraft.Count);
        for (var k = 1; k <= topN; k++)
        {
            _ruleDraft.Add(new EditableRule
            {
                SourceFinishPosition = k,
                TargetBracketName = gold.Name,
                TargetSeedSlot = (k - 1) * poolCount + 1,
                OrderBy = "pool_sequence"
            });
        }

        var silver = _bracketDraft.FirstOrDefault(b => b.Name.Equals("Silver", StringComparison.OrdinalIgnoreCase));
        if (silver is not null)
        {
            _ruleDraft.Add(new EditableRule
            {
                SourceFinishPosition = topN + 1,
                TargetBracketName = silver.Name,
                TargetSeedSlot = 1,
                OrderBy = "pool_sequence"
            });
        }
    }

