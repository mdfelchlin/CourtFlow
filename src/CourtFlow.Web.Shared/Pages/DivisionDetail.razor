@page "/divisions/{DivisionId:guid}"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_division?.Name ?? "Division") · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/divisions" Variant="Variant.Text">Divisions</MudButton>
    <MudText Typo="Typo.h5">@(_division?.Name ?? "Division")</MudText>
    @if (_division is not null)
    {
        <MudChip T="string"
                 Size="Size.Small"
                 Variant="Variant.Filled"
                 Style="@($"background-color:{CfDivisionPalette.SoftBackgroundCss(DivisionId)}")">
            Workspace
        </MudChip>
        @foreach (var stage in _stages)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StageChipColor(stage.Status)">
                @stage.Name: @StageStatusLabel(stage.Status)
            </MudChip>
        }
    }
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_division is null)
{
    <MudAlert Severity="Severity.Warning">Division not found.</MudAlert>
}
else
{
    <MudPaper Class="pa-3" Elevation="0" Outlined="true">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3" Wrap="Wrap.Wrap">
                @for (var idx = 0; idx < WizardSteps.Length; idx++)
                {
                    var stepIdx = idx;
                    var label = WizardSteps[idx];
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="@(_wizardStep == stepIdx ? Variant.Filled : Variant.Outlined)"
                             Color="@(_wizardStep == stepIdx ? Color.Primary : Color.Default)"
                             OnClick="@(() => _wizardStep = stepIdx)"
                             Style="cursor:pointer">
                        @label
                    </MudChip>
                    @if (idx < WizardSteps.Length - 1)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="mud-text-secondary" />
                    }
                }
            </MudStack>

            @if (_wizardStep == 0)
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">Step 1 · Rankings</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @if (!_editingRankings && !RankingsLocked)
                        {
                            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginEditRankingsAsync" Disabled="_teams.Count == 0">Edit order</MudButton>
                        }
                        else if (_editingRankings)
                        {
                            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveRankingsAsync" Disabled="_rankingSaveBusy">Save</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CancelEditRankings" Disabled="_rankingSaveBusy">Cancel</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Shuffle" OnClick="ShuffleRankingDraftAsync" Disabled="_rankingSaveBusy">Randomize</MudButton>
                        }
                    </MudStack>
                </MudStack>
                @if (RankingsLocked)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">Rankings are read-only while a stage is in progress.</MudAlert>
                }
                @if (_editingRankings)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Drag rows to reorder. Seeds update on Save only.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Saved order (1–N). Click Edit order to change.</MudText>
                }
                <div class="cf-ranking-table">
                    <div class="cf-ranking-head">
                        <span class="cf-ranking-handle"></span>
                        <span class="cf-ranking-num">#</span>
                        <span>Team</span>
                        <span>Club</span>
                    </div>
                    @if (_editingRankings)
                    {
                        <MudDropContainer T="TeamDto"
                                          @ref="_dropContainer"
                                          Items="_rankingDraft"
                                          ItemsSelector="ItemInRankingZone"
                                          ItemDropped="OnRankingDraftDropped"
                                          Class="cf-ranking-drop mud-width-full">
                            <ChildContent>
                                <MudDropZone T="TeamDto" Identifier="@RankingZoneId" AllowReorder="true" Class="mud-width-full" />
                            </ChildContent>
                            <ItemRenderer>
                                <MudPaper Elevation="0" Outlined="true" Class="cf-ranking-card">
                                    <div class="cf-ranking-row">
                                        <div class="cf-ranking-handle">
                                            <MudTooltip Text="Drag row to reorder">
                                                <MudIcon Icon="@Icons.Material.Filled.Menu"
                                                         Class="mud-text-secondary"
                                                         Style="cursor: grab;"
                                                         Size="Size.Medium" />
                                            </MudTooltip>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="cf-ranking-num">@RankLabelInDraft(context)</MudText>
                                        <MudText Typo="Typo.body2" Class="cf-ranking-team">@context.Name</MudText>
                                        <MudText Typo="Typo.body2" Class="cf-ranking-club">@(string.IsNullOrEmpty(context.Club) ? "—" : context.Club)</MudText>
                                    </div>
                                </MudPaper>
                            </ItemRenderer>
                        </MudDropContainer>
                    }
                    else
                    {
                        @foreach (var t in _teams)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="cf-ranking-card">
                                <div class="cf-ranking-row">
                                    <div class="cf-ranking-handle"></div>
                                    <MudText Typo="Typo.body2" Class="cf-ranking-num">@RankLabel(t)</MudText>
                                    <MudText Typo="Typo.body2" Class="cf-ranking-team">@t.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="cf-ranking-club">@(string.IsNullOrEmpty(t.Club) ? "—" : t.Club)</MudText>
                                </div>
                            </MudPaper>
                        }
                    }
                </div>
                @if (_standingsPreview?.Pools.Count > 0)
                {
                    <MudDivider Class="my-3" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                        <MudText Typo="Typo.subtitle2">Standings preview</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_standingsPreview.TiebreakerPreset</MudChip>
                    </MudStack>
                    @foreach (var pool in _standingsPreview.Pools)
                    {
                        <MudText Typo="Typo.caption" Class="mb-1">@pool.PoolName</MudText>
                        @foreach (var row in pool.Rows.Take(6))
                        {
                            <MudText Typo="Typo.body2">@row.Rank. @row.TeamName — @row.MatchWins-@row.MatchLosses</MudText>
                        }
                    }
                }
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Materialize</MudText>
                <MudStack Spacing="1">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.GridView"
                               Disabled="_materializeBusy || _editingRankings || _teams.Count < 3 || !CanSnakeIntoPools"
                               OnClick="SnakeIntoPoolsAsync">
                        Snake rankings into pools
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AccountTree"
                               Disabled="_materializeBusy || !CanResolveBracketSlots"
                               OnClick="ResolveBracketSlotsAsync">
                        Resolve bracket slots
                    </MudButton>
                    @if (!CanSnakeIntoPools && _poolDraft.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @SnakePrerequisiteHint
                        </MudText>
                    }
                </MudStack>
            }
            else if (_wizardStep == 1)
            {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.h6">Step 2 · Pool structure</MudText>
                            <MudSpacer />
                            @if (_suggestedPoolSizes.Count > 0 && _poolDraft.Count != _suggestedPoolSizes.Count)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="ApplySuggestedPoolsAsync">Apply suggested layout</MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddPoolDraftAsync">Add pool</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SavePoolStructureAsync())" Disabled="_wizardSaveBusy">Save pools</MudButton>
                        </MudStack>
                        @if (_teams.Count >= 3)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                                @PoolLayoutHints.FormatSuggestedLayout(_teams.Count)
                                Snake seeding uses this pool count even if target sizes differ.
                            </MudAlert>
                        }
                        @if (_poolBlockingReasons.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @foreach (var reason in _poolBlockingReasons)
                                {
                                    <div>@reason</div>
                                }
                            </MudAlert>
                        }
                        <MudGrid Spacing="2">
                            @foreach (var pool in _poolDraft)
                            {
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-2" Outlined="true">
                                        <MudStack Spacing="1">
                                            <MudTextField @bind-Value="pool.Name" Label="Pool name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <MudNumericField T="int" @bind-Value="pool.TargetSize" Label="Target size" Min="2" Max="8" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <MudSelect T="Guid" Label="Courts" MultiSelection="true" SelectedValues="@GetPoolCourtSelection(pool)" SelectedValuesChanged="@(ids => SetPoolCourts(pool, ids.ToList()))" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                @foreach (var court in _courts)
                                                {
                                                    <MudSelectItem T="Guid" Value="@court.Id">@court.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @for (var slot = 1; slot <= pool.TargetSize; slot++)
                                                {
                                                    var entry = PoolEntryLabel(pool, slot);
                                                    <div>@entry</div>
                                                }
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                        @if (ShowWorkRotationPanel)
                        {
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle1" Class="mb-2">Work rotation</MudText>
                            @if (_workRotationLoading)
                            {
                                <MudProgressLinear Indeterminate="true" />
                            }
                            else if (_workRotation.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">Available after Snake Rankings into Pools.</MudAlert>
                            }
                            else
                            {
                                @foreach (var pool in _workRotation)
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@pool.PoolName</MudText>
                                    <MudTable Items="pool.Matches" Dense="true" Hover="true" Class="mb-2">
                                        <HeaderContent>
                                            <MudTh>#</MudTh>
                                            <MudTh>Match</MudTh>
                                            <MudTh>WorkTeam</MudTh>
                                            <MudTh>Source</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd>@context.Order</MudTd>
                                            <MudTd>@context.HomeTeamName vs @context.AwayTeamName</MudTd>
                                            <MudTd>@(context.WorkTeamName ?? "—")</MudTd>
                                            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.AssignmentSource</MudChip></MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            }
                        }
                    }
                    else if (_wizardStep == 2)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.h6">Step 3 · Bracket structure</MudText>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddBracketDraft">Add bracket</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SaveBracketStructureAsync())" Disabled="_wizardSaveBusy">Save brackets</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateBracketsAsync" Disabled="_materializeBusy || _bracketDraft.Count == 0">Generate brackets</MudButton>
                        </MudStack>
                        @foreach (var bracket in _bracketDraft)
                        {
                            <MudPaper Class="pa-2 mb-2" Outlined="true">
                                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                    <MudTextField @bind-Value="bracket.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                    <MudNumericField T="int" @bind-Value="bracket.TeamCount" Label="Team count" Min="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudSelect T="BracketTypeDto" @bind-Value="bracket.Type" Label="Type" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem T="BracketTypeDto" Value="BracketTypeDto.SingleElimination">Single elimination</MudSelectItem>
                                        <MudSelectItem T="BracketTypeDto" Value="BracketTypeDto.DoubleElimination">Double elimination</MudSelectItem>
                                    </MudSelect>
                                    <MudSwitch T="bool" @bind-Value="bracket.IfNecessaryFinal" Label="If-necessary final" Color="Color.Primary" />
                                </MudStack>
                                @{
                                    var slots = _wizard?.BracketSeedSlots.Where(s => s.BracketName.Equals(bracket.Name, StringComparison.OrdinalIgnoreCase)).OrderBy(s => s.SeedPosition).ToList() ?? new();
                                }
                                @if (slots.Count > 0)
                                {
                                    @foreach (var slot in slots)
                                    {
                                        <MudText Typo="Typo.body2" Class="mt-1">
                                            Slot @slot.SeedPosition: @(slot.Label ?? "—")
                                            @if (slot.ManualTournamentTeamId is not null) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">Pinned</MudChip> }
                                            @if (slot.ResolvedTournamentTeamId is not null) { <span> → @TeamNameForTournamentTeam(slot.ResolvedTournamentTeamId)</span> }
                                        </MudText>
                                    }
                                }
                            </MudPaper>
                        }
                    }
                    else if (_wizardStep == 3)
                    {
                        @if (_bracketBlockingReasons.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                @foreach (var reason in _bracketBlockingReasons)
                                {
                                    <div>@reason</div>
                                }
                            </MudAlert>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.h6">Step 4 · Advancement rules</MudText>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => ApplyTopNPreset(1))">Top 1 → Gold</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => ApplyTopNPreset(2))">Top 2 → Gold</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveAdvancementRulesAsync())" Disabled="_wizardSaveBusy">Save rules</MudButton>
                        </MudStack>
                        <MudTable Items="_ruleDraft" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Pool</MudTh>
                                <MudTh>Finish</MudTh>
                                <MudTh>Target bracket</MudTh>
                                <MudTh>Slot</MudTh>
                                <MudTh>Order</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudSelect T="Guid?" @bind-Value="context.SourcePoolId" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Any pool</MudSelectItem>
                                        @foreach (var p in _poolDraft)
                                        {
                                            <MudSelectItem T="Guid?" Value="@(p.Id == Guid.Empty ? null : p.Id)">@p.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd><MudNumericField T="int" @bind-Value="context.SourceFinishPosition" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                <MudTd>
                                    <MudSelect T="string" @bind-Value="context.TargetBracketName" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        @foreach (var b in _bracketDraft)
                                        {
                                            <MudSelectItem T="string" Value="@b.Name">@b.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd><MudNumericField T="int" @bind-Value="context.TargetSeedSlot" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                <MudTd>
                                    <MudSelect T="string" @bind-Value="context.OrderBy" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem T="string" Value="@("pool_sequence")">Pool sequence</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("tiebreaker_rank")">Tiebreaker rank</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => RemoveRule(context))" /></MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRuleDraft">Add rule</MudButton>
                    }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public Guid DivisionId { get; set; }
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private DivisionDto? _division;
    private List<TeamDto> _teams = new();
    private List<StageDto> _stages = new();
    private DivisionWizardStateDto? _wizard;
    private List<CourtDto> _courts = new();
    private bool _loading = true;
    private int _wizardStep;

    private List<EditablePool> _poolDraft = new();
    private List<EditableBracket> _bracketDraft = new();
    private List<EditableRule> _ruleDraft = new();

    private bool _editingRankings;
    private List<TeamDto> _rankingDraft = new();
    private bool _rankingSaveBusy;
    private bool _materializeBusy;
    private bool _wizardSaveBusy;
    private bool _workRotationLoading;
    private List<CourtFlow.ApiClient.DivisionPoolWorkRotationDto> _workRotation = new();

    private bool ShowWorkRotationPanel => _stages.Any(s =>
        s.StageType == CourtFlow.ApiClient.StageTypeDto.Pool
        && s.Status is CourtFlow.ApiClient.StageStatusDto.Seeded
            or CourtFlow.ApiClient.StageStatusDto.InProgress
            or CourtFlow.ApiClient.StageStatusDto.Completed);

    private MudDropContainer<TeamDto>? _dropContainer;
    private const string RankingZoneId = "rankings";

    private bool RankingsLocked => _stages.Any(s => s.Status is StageStatusDto.InProgress or StageStatusDto.Completed);
    private IReadOnlyList<int> _suggestedPoolSizes => PoolLayoutHints.BuildPoolSizes(_teams.Count);

    private bool PoolsMatchSuggestedLayout =>
        _suggestedPoolSizes.Count > 0 && _poolDraft.Count == _suggestedPoolSizes.Count;

    private bool CanSnakeIntoPools =>
        _poolDraft.Count > 0
        && _teams.Count >= 3
        && _poolDraft.All(p => p.Id != Guid.Empty)
        && PoolsMatchSuggestedLayout
        && !RankingsLocked;
    private bool CanResolveBracketSlots =>
        (_wizard?.BracketSeedSlots.Count ?? 0) > 0
        && !RankingsLocked
        && _stages.Any(s => s.StageType == StageTypeDto.Pool && s.Status is StageStatusDto.Seeded or StageStatusDto.InProgress or StageStatusDto.Completed);
    private IReadOnlyList<string> _poolBlockingReasons => BuildPoolBlockingReasons();
    private IReadOnlyList<string> _bracketBlockingReasons => BuildBracketBlockingReasons();
    private DivisionStandingsDto? _standingsPreview;

    private bool ItemInRankingZone(TeamDto item, string zoneIdentifier) => zoneIdentifier == RankingZoneId;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await TournamentStore.EnsureInitializedAsync();
            var tid = TournamentStore.SelectedTournamentId;
            if (tid is null) { _division = null; return; }

            var divisions = await Api.Divisions.ListAsync(tid);
            _division = divisions.FirstOrDefault(d => d.Id == DivisionId);
            if (_division is null) return;

            await ReloadTeamsAsync();
            _stages = (await Api.Stages.ListAsync(DivisionId)).OrderBy(s => s.StageNumber).ToList();
            _wizard = await Api.Divisions.GetWizardStateAsync(DivisionId);
            await LoadCourtsAsync(tid.Value);
            SyncDraftsFromWizard();
            await LoadWorkRotationAsync();
            await LoadStandingsPreviewAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCourtsAsync(Guid tournamentId)
    {
        _courts = new();
        var venues = await Api.Venues.ListAsync(tournamentId);
        foreach (var venue in venues)
        {
            var courts = await Api.Courts.ListAsync(venue.Id);
            _courts.AddRange(courts);
        }
    }

    private void SyncDraftsFromWizard()
    {
        if (_wizard is null)
        {
            _poolDraft = new() { new EditablePool { Name = "Pool A", TargetSize = 4, Sequence = 0 } };
            _bracketDraft = new() { new EditableBracket { Name = "Gold", TeamCount = 8, Type = BracketTypeDto.SingleElimination } };
            _ruleDraft = new();
            return;
        }

        _poolDraft = _wizard.Pools.Select(p => new EditablePool
        {
            Id = p.Id,
            Name = p.Name,
            Sequence = p.Sequence,
            TargetSize = p.TargetSize,
            CourtIds = p.CourtAllocations.Select(a => a.CourtId).ToHashSet()
        }).ToList();

        if (_poolDraft.Count == 0)
            _poolDraft.Add(new EditablePool { Name = "Pool A", TargetSize = 4, Sequence = 0 });

        _bracketDraft = _wizard.Brackets.Select(b => new EditableBracket
        {
            Id = b.Id,
            Name = b.Name,
            TeamCount = b.TeamCount,
            Type = b.Type,
            IfNecessaryFinal = b.IfNecessaryFinal,
            Sequence = b.Sequence
        }).ToList();

        if (_bracketDraft.Count == 0)
            _bracketDraft.Add(new EditableBracket { Name = "Gold", TeamCount = 8, Type = BracketTypeDto.SingleElimination });

        _ruleDraft = _wizard.AdvancementRules.Select(r => new EditableRule
        {
            Id = r.Id,
            SourcePoolId = r.SourcePoolId,
            SourceFinishPosition = r.SourceFinishPosition,
            TargetBracketName = r.TargetBracketName,
            TargetSeedSlot = r.TargetSeedSlot,
            OrderBy = r.OrderBy,
            Priority = r.Priority
        }).ToList();
    }

    private async Task LoadWorkRotationAsync()
    {
        if (!ShowWorkRotationPanel) { _workRotation = new(); return; }
        _workRotationLoading = true;
        try
        {
            _workRotation = (await Api.Divisions.GetWorkRotationAsync(DivisionId)).ToList();
        }
        catch
        {
            _workRotation = new();
        }
        finally { _workRotationLoading = false; }
    }

    private async Task ReloadTeamsAsync()
    {
        _editingRankings = false;
        _rankingDraft = new();
        var teams = await Api.Teams.ListAsync(divisionId: DivisionId);
        _teams = teams.OrderBy(t => t.SeedHint ?? int.MaxValue).ThenBy(t => t.Id).ToList();
    }

    private int RankLabel(TeamDto team) => _teams.FindIndex(t => t.Id == team.Id) + 1;
    private int RankLabelInDraft(TeamDto team) => _rankingDraft.FindIndex(t => t.Id == team.Id) + 1;

    private Task BeginEditRankingsAsync()
    {
        _rankingDraft = _teams.ToList();
        _editingRankings = true;
        return Task.CompletedTask;
    }

    private void CancelEditRankings()
    {
        _editingRankings = false;
        _rankingDraft = new();
    }

    private async Task SaveRankingsAsync()
    {
        if (_rankingDraft.Count == 0) return;
        _rankingSaveBusy = true;
        try
        {
            var ids = _rankingDraft.Select(t => t.Id).ToList();
            var updated = await Api.Divisions.ReorderTeamsAsync(DivisionId, new ReorderDivisionTeamsDto(ids));
            var byId = updated.ToDictionary(t => t.Id);
            _teams = ids.Select(id => byId.TryGetValue(id, out var u) ? u : _rankingDraft.First(t => t.Id == id)).ToList();
            _editingRankings = false;
            _rankingDraft = new();
            _dropContainer?.Refresh();
            Snackbar.Add("Rankings saved", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _rankingSaveBusy = false; }
    }

    private Task OnRankingDraftDropped(MudItemDropInfo<TeamDto> info)
    {
        if (info.Item is null) return Task.CompletedTask;
        var list = _rankingDraft.ToList();
        var from = list.FindIndex(t => t.Id == info.Item.Id);
        if (from < 0) return Task.CompletedTask;
        var moved = list[from];
        list.RemoveAt(from);
        var to = Math.Clamp(info.IndexInZone, 0, list.Count);
        list.Insert(to, moved);
        _rankingDraft = list;
        _dropContainer?.Refresh();
        return Task.CompletedTask;
    }

    private Task ShuffleRankingDraftAsync()
    {
        if (!_editingRankings || _rankingDraft.Count == 0) return Task.CompletedTask;
        var rnd = new Random();
        var list = _rankingDraft.ToList();
        for (var i = list.Count - 1; i > 0; i--)
        {
            var j = rnd.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
        _rankingDraft = list;
        _dropContainer?.Refresh();
        return Task.CompletedTask;
    }

    private async Task SnakeIntoPoolsAsync()
    {
        if (_poolBlockingReasons.Count > 0)
        {
            Snackbar.Add("Fix pool structure issues in Step 2 before snaking.", Severity.Warning);
            _wizardStep = 1;
            return;
        }

        if (_poolDraft.Any(p => p.Id == Guid.Empty))
        {
            Snackbar.Add("Save pool structure in Step 2 before snaking.", Severity.Warning);
            _wizardStep = 1;
            return;
        }

        _materializeBusy = true;
        try
        {
            await Api.Divisions.SnakeIntoPoolsAsync(DivisionId);
            await ReloadTeamsAsync();
            _stages = (await Api.Stages.ListAsync(DivisionId)).OrderBy(s => s.StageNumber).ToList();
            _wizard = await Api.Divisions.GetWizardStateAsync(DivisionId);
            SyncDraftsFromWizard();
            await LoadWorkRotationAsync();
            _wizardStep = 1;
            Snackbar.Add("Rankings snaked into pools; pool matches generated.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _materializeBusy = false; }
    }

    private async Task GenerateBracketsAsync()
    {
        _materializeBusy = true;
        try
        {
            await SaveBracketStructureAsync(silent: true);
            await SaveAdvancementRulesAsync(silent: true);
            await Api.Divisions.GenerateBracketsAsync(DivisionId);
            _wizard = await Api.Divisions.GetWizardStateAsync(DivisionId);
            _stages = (await Api.Stages.ListAsync(DivisionId)).OrderBy(s => s.StageNumber).ToList();
            Snackbar.Add("Bracket seed slots and tree generated.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _materializeBusy = false; }
    }

    private async Task ResolveBracketSlotsAsync()
