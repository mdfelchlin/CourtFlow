    private async Task RemoveBracketDraftAsync(EditableBracket bracket)
    {
        if (BracketsLocked)
        {
            Snackbar.Add("Bracket structure cannot be changed while the bracket stage is in progress.", Severity.Warning);
            return;
        }

        if (_bracketDraft.Count <= 1)
        {
            Snackbar.Add("At least one bracket is required.", Severity.Warning);
            return;
        }

        var name = bracket.Name;
        var wasSaved = bracket.Id is not null;
        _bracketDraft.Remove(bracket);
        _ruleDraft.RemoveAll(r => r.TargetBracketName.Equals(name, StringComparison.OrdinalIgnoreCase));

        if (wasSaved)
        {
            try
            {
                await SaveBracketStructureAsync(silent: true);
                await SaveAdvancementRulesAsync(silent: true);
                Snackbar.Add($"Bracket \"{name}\" removed.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private void AddRuleDraft() =>
