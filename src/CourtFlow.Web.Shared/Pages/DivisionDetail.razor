    private void RemoveRule(EditableRule rule) => _ruleDraft.Remove(rule);

    private void ApplyTopNPreset(int topN)
    {
        _ruleDraft.Clear();
        var gold = _bracketDraft.FirstOrDefault(b => b.Name.Equals("Gold", StringComparison.OrdinalIgnoreCase)) ?? _bracketDraft.FirstOrDefault();
        if (gold is null) return;

        var poolCount = Math.Max(1, _poolDraft.Count);
        for (var k = 1; k <= topN; k++)
        {
            _ruleDraft.Add(new EditableRule
            {
                SourceFinishPosition = k,
                TargetBracketName = gold.Name,
                TargetSeedSlot = (k - 1) * poolCount + 1,
                OrderBy = "pool_sequence"
            });
        }

        gold.TeamCount = SuggestedTeamCountForBracket(gold.Name);

        var silver = _bracketDraft.FirstOrDefault(b => b.Name.Equals("Silver", StringComparison.OrdinalIgnoreCase));
        if (silver is not null)
        {
            _ruleDraft.Add(new EditableRule
            {
                SourceFinishPosition = topN + 1,
                TargetBracketName = silver.Name,
                TargetSeedSlot = 1,
                OrderBy = "pool_sequence"
            });
            silver.TeamCount = SuggestedTeamCountForBracket(silver.Name);
        }
    }

    private static readonly string[] WizardSteps = ["Ranking", "Pool", "Bracket"];
    private static readonly string[] WizardStepSlugs = ["ranking", "pool", "bracket"];

    private int DefaultBracketTeamCount(string bracketName) =>
        SuggestedTeamCountForBracket(bracketName);

    private int SuggestedTeamCountForBracket(string bracketName)
    {
        var poolCount = Math.Max(1, _poolDraft.Count);
        var rules = _ruleDraft
            .Where(r => r.TargetBracketName.Equals(bracketName, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (rules.Count == 0)
            return Math.Max(2, poolCount);

        var maxSlot = 0;
        foreach (var rule in rules)
        {
            var endSlot = rule.SourcePoolId is null
                ? rule.TargetSeedSlot + poolCount - 1
                : rule.TargetSeedSlot;
            maxSlot = Math.Max(maxSlot, endSlot);
        }
        return Math.Max(2, maxSlot);
    }

    private void SyncBracketTeamCountsFromRules()
    {
        foreach (var bracket in _bracketDraft)
            bracket.TeamCount = SuggestedTeamCountForBracket(bracket.Name);
    }

    private void ApplySuggestedTeamCount(EditableBracket bracket) =>
        bracket.TeamCount = SuggestedTeamCountForBracket(bracket.Name);

    private string AdvancementRulesSummary()
    {
        if (_ruleDraft.Count == 0) return "";
        var parts = _ruleDraft
            .GroupBy(r => r.TargetBracketName, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var wildcard = g.Where(r => r.SourcePoolId is null).ToList();
                if (wildcard.Count == 0)
                    return $"{g.Key}: {g.Count()} rule(s)";
                var maxFinish = wildcard.Max(r => r.SourceFinishPosition);
                var order = wildcard.First().OrderBy == "tiebreaker_rank" ? "tiebreaker rank" : "pool sequence";
                return $"{g.Key} ← top {maxFinish} from each pool ({order})";
            });
        return string.Join(" · ", parts);
    }

