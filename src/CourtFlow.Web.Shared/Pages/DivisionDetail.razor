@page "/divisions/{DivisionId:guid}"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_division?.Name ?? "Division") · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/divisions" Variant="Variant.Text">Divisions</MudButton>
    <MudText Typo="Typo.h5">@(_division?.Name ?? "Division")</MudText>
    @if (_division is not null)
    {
        <MudChip T="string"
                 Size="Size.Small"
                 Variant="Variant.Filled"
                 Style="@($"background-color:{CfDivisionPalette.SoftBackgroundCss(DivisionId)}")">
            Workspace
        </MudChip>
    }
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_division is null)
{
    <MudAlert Severity="Severity.Warning">Division not found.</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">Rankings</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @if (!_editingRankings)
                        {
                            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginEditRankingsAsync" Disabled="_teams.Count == 0">Edit order</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveRankingsAsync" Disabled="_rankingSaveBusy">Save</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CancelEditRankings" Disabled="_rankingSaveBusy">Cancel</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Shuffle" OnClick="ShuffleRankingDraftAsync" Disabled="_rankingSaveBusy">Randomize</MudButton>
                        }
                    </MudStack>
                </MudStack>
                @if (_editingRankings)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Drag rows to reorder. Seeds update on Save only.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Saved order (1–N). Click Edit order to change.</MudText>
                }
                <div class="cf-ranking-table">
                    <div class="cf-ranking-head">
                        <span class="cf-ranking-handle"></span>
                        <span class="cf-ranking-num">#</span>
                        <span>Team</span>
                        <span>Club</span>
                    </div>
                    @if (_editingRankings)
                    {
                        <MudDropContainer T="TeamDto"
                                          @ref="_dropContainer"
                                          Items="_rankingDraft"
                                          ItemsSelector="ItemInRankingZone"
                                          ItemDropped="OnRankingDraftDropped"
                                          Class="cf-ranking-drop mud-width-full">
                            <ChildContent>
                                <MudDropZone T="TeamDto" Identifier="@RankingZoneId" AllowReorder="true" Class="mud-width-full" />
                            </ChildContent>
                            <ItemRenderer>
                                <MudPaper Elevation="0" Outlined="true" Class="cf-ranking-card">
                                    <div class="cf-ranking-row">
                                        <div class="cf-ranking-handle">
                                            <MudTooltip Text="Drag row to reorder">
                                                <MudIcon Icon="@Icons.Material.Filled.Menu"
                                                         Class="mud-text-secondary"
                                                         Style="cursor: grab;"
                                                         Size="Size.Medium" />
                                            </MudTooltip>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="cf-ranking-num">@RankLabelInDraft(context)</MudText>
                                        <MudText Typo="Typo.body2" Class="cf-ranking-team">@context.Name</MudText>
                                        <MudText Typo="Typo.body2" Class="cf-ranking-club">@(string.IsNullOrEmpty(context.Club) ? "—" : context.Club)</MudText>
                                    </div>
                                </MudPaper>
                            </ItemRenderer>
                        </MudDropContainer>
                    }
                    else
                    {
                        @foreach (var t in _teams)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="cf-ranking-card">
                                <div class="cf-ranking-row">
                                    <div class="cf-ranking-handle"></div>
                                    <MudText Typo="Typo.body2" Class="cf-ranking-num">@RankLabel(t)</MudText>
                                    <MudText Typo="Typo.body2" Class="cf-ranking-team">@t.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="cf-ranking-club">@(string.IsNullOrEmpty(t.Club) ? "—" : t.Club)</MudText>
                                </div>
                            </MudPaper>
                        }
                    }
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="7">
            <MudTabs Elevation="0" Outlined="true" Rounded="true" @bind-ActivePanelIndex="_tabIndex">
                <MudTabPanel Text="Pools">
                    <MudStack Spacing="2" Class="pa-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudSelect T="RankedSeedStrategyDto" @bind-Value="_seedStrategy" Label="Pool format" Dense="true" Variant="Variant.Outlined" Class="cf-select--md" Disabled="_editingRankings">
                                <MudSelectItem T="RankedSeedStrategyDto" Value="RankedSeedStrategyDto.Snake">Snake</MudSelectItem>
                            </MudSelect>
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApplySeedingAsync" Disabled="_teams.Count < 3 || _editingRankings">Apply seeding</MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="NewPoolAsync">Add pool</MudButton>
                        </MudStack>
                        @if (_editingRankings)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-1">Save or cancel rankings changes before applying pool seeding (seeding uses saved order).</MudAlert>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Move teams between pools with the dropdown, or apply snake seeding from current rankings.</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudPaper Class="pa-2 mud-height-full" Outlined="true">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Unassigned</MudText>
                                    @foreach (var t in TeamsInPool(null))
                                    {
                                        <MudPaper Class="pa-2 mb-1" Outlined="true">
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.body2">@t.Name</MudText>
                                                <MudSelect T="Guid?" Value="t.PoolId" ValueChanged="@(pid => MoveTeamToPoolAsync(t, pid))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="Pool">
                                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Unassigned</MudSelectItem>
                                                    @foreach (var p in _pools)
                                                    {
                                                        <MudSelectItem T="Guid?" Value="@p.Id">@p.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                </MudPaper>
                            </MudItem>
                            @foreach (var pool in _pools)
                            {
                                <MudItem xs="12" sm="6" md="4" lg="3">
                                    <MudPaper Class="pa-2 mud-height-full" Outlined="true">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                            <MudText Typo="Typo.subtitle2">@pool.Name</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeletePoolAsync(pool))" aria-label="Delete pool" />
                                        </MudStack>
                                        @foreach (var t in TeamsInPool(pool.Id))
                                        {
                                            <MudPaper Class="pa-2 mb-1" Outlined="true">
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.body2">@t.Name</MudText>
                                                    <MudSelect T="Guid?" Value="t.PoolId" ValueChanged="@(pid => MoveTeamToPoolAsync(t, pid))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="Pool">
                                                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Unassigned</MudSelectItem>
                                                        @foreach (var p in _pools)
                                                        {
                                                            <MudSelectItem T="Guid?" Value="@p.Id">@p.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>
                <MudTabPanel Text="Brackets">
                    <MudStack Spacing="2" Class="pa-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudNumericField T="int" @bind-Value="_topNPerPool" Label="Top N per pool (Gold)" Min="1" Variant="Variant.Outlined" Class="cf-select--sm" />
                            <MudSelect T="BracketTypeDto" @bind-Value="_bracketType" Label="Bracket type" Dense="true" Variant="Variant.Outlined" Class="cf-select--md">
                                <MudSelectItem T="BracketTypeDto" Value="BracketTypeDto.SingleElimination">Single elimination</MudSelectItem>
                                <MudSelectItem T="BracketTypeDto" Value="BracketTypeDto.DoubleElimination">Double elimination</MudSelectItem>
                            </MudSelect>
                            <MudSwitch T="bool" @bind-Value="_ifNecessaryFinal" Label="If-necessary final" Color="Color.Primary" />
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GenerateAdvancementAsync">Generate Gold / Silver</MudButton>
                            <MudButton Variant="Variant.Outlined" OnClick="LoadStandingsPreviewAsync">Refresh standings</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Uses pool match results. Optional manual lists override auto-selection from standings.</MudText>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudTextField @bind-Value="_goldOverrideText" Label="Gold team IDs (optional, comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Style="min-width:220px" />
                            <MudTextField @bind-Value="_silverOverrideText" Label="Silver team IDs (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Style="min-width:220px" />
                        </MudStack>
                        @if (_standingsPreview.Count > 0)
                        {
                            @foreach (var pool in _standingsPreview)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-2">@pool.PoolName</MudText>
                                <MudTable Items="pool.Rows" Dense="true" Hover="true" Class="mb-2">
                                    <HeaderContent>
                                        <MudTh>Rank</MudTh>
                                        <MudTh>Team</MudTh>
                                        <MudTh>W-L</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Rank</MudTd>
                                        <MudTd>@context.TeamName</MudTd>
                                        <MudTd>@context.MatchWins-@context.MatchLosses</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        }
                        else if (_standingsLoaded)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">No standings yet (finish pool matches or refresh after scheduling).</MudAlert>
                        }
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid DivisionId { get; set; }
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private DivisionDto? _division;
    private List<TeamDto> _teams = new();
    private List<PoolDto> _pools = new();
    private bool _loading = true;
    private int _tabIndex;
    private RankedSeedStrategyDto _seedStrategy = RankedSeedStrategyDto.Snake;
    private int _topNPerPool = 2;
    private BracketTypeDto _bracketType = BracketTypeDto.SingleElimination;
    private bool _ifNecessaryFinal;
    private List<PoolStandingsDto> _standingsPreview = new();
    private bool _standingsLoaded;
    private string _goldOverrideText = "";
    private string _silverOverrideText = "";

    private bool _editingRankings;
    private List<TeamDto> _rankingDraft = new();
    private bool _rankingSaveBusy;

    private MudDropContainer<TeamDto>? _dropContainer;

    private const string RankingZoneId = "rankings";

    /// <summary>MudBlazor 8+: (item, dropZoneId) => whether the item is shown in that zone.</summary>
    private bool ItemInRankingZone(TeamDto item, string zoneIdentifier) => zoneIdentifier == RankingZoneId;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await TournamentStore.EnsureInitializedAsync();
            var tid = TournamentStore.SelectedTournamentId;
            if (tid is null)
            {
                _division = null;
                _editingRankings = false;
                _rankingDraft = new();
                return;
            }
            var divisions = await Api.Divisions.ListAsync(tid);
            _division = divisions.FirstOrDefault(d => d.Id == DivisionId);
            if (_division is null)
            {
                _editingRankings = false;
                _rankingDraft = new();
                return;
            }

            await ReloadTeamsAndPoolsAsync();
            _standingsLoaded = false;
            _standingsPreview = new();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadTeamsAndPoolsAsync()
    {
        _editingRankings = false;
        _rankingDraft = new();

        var teams = await Api.Teams.ListAsync(divisionId: DivisionId);
        // Match ListTeamsHandler for divisions: numeric SeedHint, then stable Id (not name — avoids alphabetical tie-break).
        _teams = teams
            .OrderBy(t => t.SeedHint ?? int.MaxValue)
            .ThenBy(t => t.Id)
            .ToList();
        _pools = (await Api.Pools.ListAsync(DivisionId)).OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private IEnumerable<TeamDto> TeamsInPool(Guid? poolId) =>
        _teams.Where(t => t.PoolId == poolId).OrderBy(t => t.SeedHint ?? int.MaxValue).ThenBy(t => t.Id);

    /// <summary>Rank in the saved list: position 1..N.</summary>
    private int RankLabel(TeamDto team)
    {
        var i = _teams.FindIndex(t => t.Id == team.Id);
        return i >= 0 ? i + 1 : 0;
    }

    private int RankLabelInDraft(TeamDto team)
    {
        var i = _rankingDraft.FindIndex(t => t.Id == team.Id);
        return i >= 0 ? i + 1 : 0;
    }

    private Task BeginEditRankingsAsync()
    {
        _rankingDraft = _teams.ToList();
        _editingRankings = true;
        return Task.CompletedTask;
    }

    private void CancelEditRankings()
    {
        _editingRankings = false;
        _rankingDraft = new();
    }

    private async Task SaveRankingsAsync()
    {
        if (_rankingDraft.Count == 0) return;
        _rankingSaveBusy = true;
        try
        {
            var ids = _rankingDraft.Select(t => t.Id).ToList();
            var updated = await Api.Divisions.ReorderTeamsAsync(DivisionId, new ReorderDivisionTeamsDto(ids));
            ApplyReorderResponseToTeams(_rankingDraft, updated);
            _editingRankings = false;
            _rankingDraft = new();
            _dropContainer?.Refresh();
            Snackbar.Add("Rankings saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _rankingSaveBusy = false;
        }
    }

    /// <summary>Merges API team DTOs into the given order and assigns the result to committed teams.</summary>
    private void ApplyReorderResponseToTeams(IReadOnlyList<TeamDto> order, IReadOnlyList<TeamDto> updated)
    {
        var byId = updated.ToDictionary(t => t.Id);
        _teams = order.Select(t => byId.TryGetValue(t.Id, out var u) ? u : t).ToList();
    }

    private Task OnRankingDraftDropped(MudItemDropInfo<TeamDto> info)
    {
        if (info.Item is null) return Task.CompletedTask;

        var list = _rankingDraft.ToList();
        var from = list.FindIndex(t => t.Id == info.Item.Id);
        if (from < 0) return Task.CompletedTask;

        var moved = list[from];
        list.RemoveAt(from);

        var to = info.IndexInZone;
        if (to < 0) to = 0;
        if (to > list.Count) to = list.Count;
        list.Insert(to, moved);

        _rankingDraft = list;
        _dropContainer?.Refresh();
        return Task.CompletedTask;
    }

    private Task ShuffleRankingDraftAsync()
    {
        if (!_editingRankings || _rankingDraft.Count == 0) return Task.CompletedTask;

        var rnd = new Random();
        var list = _rankingDraft.ToList();
        for (var i = list.Count - 1; i > 0; i--)
        {
            var j = rnd.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }

        _rankingDraft = list;
        _dropContainer?.Refresh();
        return Task.CompletedTask;
    }

    private async Task ApplySeedingAsync()
    {
        try
        {
            var r = await Api.Divisions.ApplySeedingAsync(DivisionId, new ApplyDivisionSeedingDto(_seedStrategy));
            if (!r.Ok)
            {
                Snackbar.Add(r.Error ?? "Seeding failed", Severity.Warning);
                return;
            }
            await ReloadTeamsAndPoolsAsync();
            Snackbar.Add("Seeding applied", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MoveTeamToPoolAsync(TeamDto team, Guid? poolId)
    {
        try
        {
            var dto = await Api.Teams.AssignPoolAsync(team.Id, new AssignTeamPoolDto(poolId));
            var ix = _teams.FindIndex(t => t.Id == team.Id);
            if (ix >= 0) _teams[ix] = dto;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task NewPoolAsync()
    {
        var parms = new DialogParameters { ["DivisionId"] = DivisionId };
        var dialog = await DialogService.ShowAsync<PoolDialog>("New pool", parms);
        if ((await dialog.Result) is { Canceled: false })
            await ReloadTeamsAndPoolsAsync();
    }

    private async Task DeletePoolAsync(PoolDto pool)
    {
        var ok = await DialogService.ShowMessageBox("Delete pool", $"Delete '{pool.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await Api.Pools.DeleteAsync(pool.Id);
            await ReloadTeamsAndPoolsAsync();
            Snackbar.Add("Pool removed", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadStandingsPreviewAsync()
    {
        try
        {
            _standingsPreview = (await Api.Standings.ForDivisionAsync(DivisionId)).ToList();
            _standingsLoaded = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task GenerateAdvancementAsync()
    {
        IReadOnlyList<Guid>? gold = null;
        IReadOnlyList<Guid>? silver = null;
        if (!string.IsNullOrWhiteSpace(_goldOverrideText))
        {
            var g = ParseGuidList(_goldOverrideText);
            if (g is null) { Snackbar.Add("Invalid Gold team IDs", Severity.Warning); return; }
            gold = g;
        }
        if (!string.IsNullOrWhiteSpace(_silverOverrideText))
        {
            var s = ParseGuidList(_silverOverrideText);
            if (s is null) { Snackbar.Add("Invalid Silver team IDs", Severity.Warning); return; }
            silver = s;
        }

        try
        {
            var r = await Api.Divisions.GenerateAdvancementBracketsAsync(DivisionId, new GenerateAdvancementBracketsDto(
                _topNPerPool,
                _bracketType,
                _ifNecessaryFinal,
                gold,
                silver));
            if (!string.IsNullOrEmpty(r.Error))
            {
                Snackbar.Add(r.Error, Severity.Warning);
                return;
            }
            Snackbar.Add($"Generated {r.Brackets.Count} bracket(s)", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static List<Guid>? ParseGuidList(string text)
    {
        var parts = text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var list = new List<Guid>();
        foreach (var p in parts)
        {
            if (!Guid.TryParse(p, out var g)) return null;
            list.Add(g);
        }
        return list;
    }
}
