    private List<string> BuildPoolBlockingReasons()
    {
        var reasons = new List<string>();
        if (_poolDraft.Count == 0) reasons.Add("Pool count must be ≥ 1.");
        if (_suggestedPoolSizes.Count > 0 && _poolDraft.Count != _suggestedPoolSizes.Count)
            reasons.Add($"For {_teams.Count} teams, use {_suggestedPoolSizes.Count} pool(s) ({string.Join(" + ", _suggestedPoolSizes)}).");
        if (_poolDraft.Any(p => p.TargetSize < 2 || p.TargetSize > 8)) reasons.Add("Each pool target size must be between 2 and 8.");
        if (_poolDraft.Select(p => p.Name.Trim().ToLowerInvariant()).Distinct().Count() != _poolDraft.Count) reasons.Add("Pool names must be unique.");
        return reasons;
    }

    private List<string> BuildBracketBlockingReasons()
    {
        var reasons = new List<string>();
        if (_bracketDraft.Count == 0) reasons.Add("Add at least one bracket before generating.");
        if (_ruleDraft.Count == 0) reasons.Add("Add advancement rules or apply a preset.");
        if (!_stages.Any(s => s.StageType == StageTypeDto.Pool && s.Status is StageStatusDto.Seeded or StageStatusDto.InProgress or StageStatusDto.Completed))
            reasons.Add("Snake rankings into pools before resolving bracket slots.");
        return reasons;
    }

    private static string StageStatusLabel(StageStatusDto status) => status switch
    {
        StageStatusDto.Draft => "Draft",
        StageStatusDto.Configured => "Configured",
        StageStatusDto.Seeded => "Seeded",
        StageStatusDto.InProgress => "In progress",
        StageStatusDto.Completed => "Completed",
        _ => status.ToString(),
    };

    private static Color StageChipColor(StageStatusDto status) => status switch
    {
        StageStatusDto.Completed => Color.Success,
        StageStatusDto.InProgress => Color.Primary,
        StageStatusDto.Seeded => Color.Info,
        StageStatusDto.Configured => Color.Warning,
        _ => Color.Default,
    };

