    private string PoolEntryLabel(EditablePool pool, int slot)
    {
        if (_wizard is null) return $"{pool.Name} · {slot}: —";
        var entries = _teams.Where(t => t.PoolId == pool.Id).OrderBy(t => t.SeedHint ?? int.MaxValue).ToList();
        if (slot <= entries.Count) return $"{pool.Name} · {slot}: {entries[slot - 1].Name}";
        return $"{pool.Name} · {slot}: —";
    }

    private string TeamNameForTournamentTeam(Guid? tournamentTeamId)
    {
        if (tournamentTeamId is null) return "—";
        var team = _teams.FirstOrDefault(t => t.TournamentTeamId == tournamentTeamId);
        return team?.Name ?? tournamentTeamId.Value.ToString()[..8];
    }

