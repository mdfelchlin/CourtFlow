    private void SyncDraftsFromWizard()
    {
        if (_wizard is null)
        {
            _poolDraft = new() { new EditablePool { Name = "Pool A", TargetSize = _poolSettingsDraft.TeamsPerPoolTarget, Sequence = 0 } };
            _bracketDraft = new() { new EditableBracket { Name = "Gold", TeamCount = DefaultBracketTeamCount("Gold"), Type = BracketTypeDto.SingleElimination } };
            _ruleDraft = new();
            return;
        }

        _poolDraft = _wizard.Pools.Select(p => new EditablePool
        {
            Id = p.Id,
            Name = p.Name,
            Sequence = p.Sequence,
            TargetSize = p.TargetSize,
            CourtIds = p.CourtAllocations.Select(a => a.CourtId).ToHashSet()
        }).ToList();

        if (_poolDraft.Count == 0)
            _poolDraft.Add(new EditablePool { Name = "Pool A", TargetSize = _poolSettingsDraft.TeamsPerPoolTarget, Sequence = 0 });

        _bracketDraft = _wizard.Brackets.Select(b => new EditableBracket
        {
            Id = b.Id,
            Name = b.Name,
            TeamCount = b.TeamCount,
            Type = b.Type,
            IfNecessaryFinal = b.IfNecessaryFinal,
            Sequence = b.Sequence
        }).ToList();

        if (_bracketDraft.Count == 0)
            _bracketDraft.Add(new EditableBracket { Name = "Gold", TeamCount = DefaultBracketTeamCount("Gold"), Type = BracketTypeDto.SingleElimination });

        _ruleDraft = _wizard.AdvancementRules.Select(r => new EditableRule
        {
            Id = r.Id,
            SourcePoolId = r.SourcePoolId,
            SourceFinishPosition = r.SourceFinishPosition,
            TargetBracketName = r.TargetBracketName,
            TargetSeedSlot = r.TargetSeedSlot,
            OrderBy = r.OrderBy,
            Priority = r.Priority
        }).ToList();

        if (_wizard.PoolSettings is { } ps)
        {
            _poolSettingsDraft = new PoolSettingsDraft
            {
                TeamsPerPoolTarget = ps.TeamsPerPoolTarget,
                PoolSizeStrategy = ps.PoolSizeStrategy,
                SeedingMethod = ps.SeedingMethod,
                ClubSeparationMode = ps.ClubSeparationMode,
                PlayStyle = ps.PlayStyle,
                CourtAllocationMode = ps.CourtAllocationMode,
                RefAssignmentMode = ps.RefAssignmentMode
            };
        }

        if (_ruleDraft.Count > 0)
            SyncBracketTeamCountsFromRules();
    }

