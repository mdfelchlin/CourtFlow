@page "/tournaments"
@attribute [Authorize]
@using Microsoft.Extensions.Hosting
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IHostEnvironment Env

<PageTitle>Tournaments · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudText Typo="Typo.h4">Tournaments</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        @if (Env.IsDevelopment())
        {
            <MudButton StartIcon="@Icons.Material.Filled.Casino"
                       Color="Color.Secondary"
                       Variant="Variant.Outlined"
                       Size="Size.Small"
                       Class="cf-toolbar-btn"
                       Disabled="_creatingRandom"
                       aria-label="Create random test tournament"
                       OnClick="CreateRandomTestTournamentAsync">
                Random test
            </MudButton>
        }
        <CfToolbarAddButton OnClick="New" AriaLabel="Add tournament" />
    </MudStack>
</MudStack>

<MudDataGrid T="TournamentDto" Items="_items" Loading="_loading" Dense="true" Hover="true" Striped="false" Class="cf-tournaments-grid">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <TemplateColumn Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Item.PublicationStatus</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.StartDate" Title="Start" />
        <PropertyColumn Property="x => x.EndDate" Title="End" />
        <TemplateColumn Title="Time zone">
            <CellTemplate>@TimeZoneOptions.Label(context.Item.TimeZoneId)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.DefaultMatchDurationMinutes" Title="Match (min)" />
        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit tournament" OnClick="@(() => Edit(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.CopyAll" Size="Size.Small" aria-label="Clone tournament" OnClick="@(() => CloneAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete tournament" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private IReadOnlyList<TournamentDto> _items = Array.Empty<TournamentDto>();
    private bool _loading = true;
    private bool _creatingRandom;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _items = await Api.Tournaments.ListAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private void New() => Nav.NavigateTo("/tournaments/new");

    private async Task CreateRandomTestTournamentAsync()
    {
        if (!Env.IsDevelopment()) return;

        _creatingRandom = true;
        try
        {
            var rnd = Random.Shared;
            var name = $"Test tournament {rnd.Next(1000, 9999)}";
            var start = DateOnly.FromDateTime(DateTime.Today);
            var end = start.AddDays(rnd.Next(1, 8));
            var tz = TimeZoneOptions.All[rnd.Next(TimeZoneOptions.All.Count)].Id;
            var durations = new[] { 15, 30, 45, 60, 90 };
            var duration = durations[rnd.Next(durations.Length)];

            var created = await Api.Tournaments.CreateAsync(
                new CreateTournamentDto(name, "Dev-only random seed for testing.", start, end, tz, duration));

            var venuePlans = new (string Name, string? Address, (string CourtName, string[] Tags)[] Courts)[]
            {
                (
                    "Dev · Main convention center",
                    "100 Dev Test Blvd, Sample City, ST 00000",
                    new (string, string[])[]
                    {
                        ("Show Court 1", new[] { "featured", "portable" }),
                        ("Show Court 2", new[] { "portable" }),
                        ("Hall 3", new[] { "side" }),
                        ("Hall 4", Array.Empty<string>()),
                    }),
                (
                    "Dev · Satellite gym",
                    "210 Practice Ln, Sample City, ST 00000",
                    new (string, string[])[]
                    {
                        ("North bay", new[] { "net-fixed" }),
                        ("South bay", new[] { "net-fixed" }),
                        ("Practice strip", Array.Empty<string>()),
                    }),
            };

            var courtTotal = 0;
            foreach (var (vName, address, courts) in venuePlans)
            {
                var venue = await Api.Venues.CreateAsync(new CreateVenueDto(created.Id, vName, address));
                foreach (var (courtName, tags) in courts)
                {
                    await Api.Courts.CreateAsync(new CreateCourtDto(venue.Id, courtName, tags));
                    courtTotal++;
                }
            }

            var divisions = new[]
            {
                ("Dev · Pool play (small)", DivisionFormatDto.PoolOnly, MaxTeams: 16, TeamCount: 4),
                ("Dev · Pool + bracket (medium)", DivisionFormatDto.PoolPlusBracket, MaxTeams: 24, TeamCount: 11),
                ("Dev · Bracket (large)", DivisionFormatDto.BracketOnly, MaxTeams: 32, TeamCount: 17),
            };

            var teamTotal = 0;
            for (var d = 0; d < divisions.Length; d++)
            {
                var (divName, format, maxTeams, teamCount) = divisions[d];
                var division = await Api.Divisions.CreateAsync(
                    new CreateDivisionDto(created.Id, divName, format, maxTeams));
                var prefix = (char)('A' + d);
                for (var i = 1; i <= teamCount; i++)
                {
                    await Api.Teams.CreateAsync(new CreateTeamDto(
                        division.Id,
                        $"Team {prefix}-{i:00}",
                        i % 4 == 0 ? null : $"Test club {(char)('A' + (i % 5))}"));
                    teamTotal++;
                }
            }

            Snackbar.Add($"Random test tournament: {venuePlans.Length} venues, {courtTotal} courts, {divisions.Length} divisions, {teamTotal} teams.", Severity.Success);
            Nav.NavigateTo($"/tournaments/{created.Id}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _creatingRandom = false; }
    }

    private void Edit(TournamentDto t) => Nav.NavigateTo($"/tournaments/{t.Id}");

    private async Task CloneAsync(TournamentDto t)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "Clone tournament",
            $"Create a duplicate of '{t.Name}' (structures and teams copied; schedules and brackets are not).",
            yesText: "Clone",
            cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            var created = await Api.Tournaments.CloneAsync(t.Id);
            Snackbar.Add("Tournament cloned", Severity.Success);
            Nav.NavigateTo($"/tournaments/{created.Id}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteAsync(TournamentDto t)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete tournament", $"Delete '{t.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try { await Api.Tournaments.DeleteAsync(t.Id); Snackbar.Add("Deleted", Severity.Success); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
