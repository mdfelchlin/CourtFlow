@page "/tournaments"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Tournaments · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudText Typo="Typo.h4">Tournaments</MudText>
    <CfToolbarAddButton OnClick="New" AriaLabel="Add tournament" />
</MudStack>

<MudDataGrid T="TournamentDto" Items="_items" Loading="_loading" Dense="true" Hover="true" Striped="false" Class="cf-tournaments-grid">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <TemplateColumn Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Item.PublicationStatus</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.StartDate" Title="Start" />
        <PropertyColumn Property="x => x.EndDate" Title="End" />
        <TemplateColumn Title="Time zone">
            <CellTemplate>@TimeZoneOptions.Label(context.Item.TimeZoneId)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.DefaultMatchDurationMinutes" Title="Match (min)" />
        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit tournament" OnClick="@(() => Edit(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.CopyAll" Size="Size.Small" aria-label="Clone tournament" OnClick="@(() => CloneAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete tournament" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private IReadOnlyList<TournamentDto> _items = Array.Empty<TournamentDto>();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _items = await Api.Tournaments.ListAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private void New() => Nav.NavigateTo("/tournaments/new");

    private void Edit(TournamentDto t) => Nav.NavigateTo($"/tournaments/{t.Id}");

    private async Task CloneAsync(TournamentDto t)
    {
        var ok = await DialogService.ShowMessageBox(
            "Clone tournament",
            $"Create a duplicate of '{t.Name}' (structures and teams copied; schedules and brackets are not).",
            yesText: "Clone",
            cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            var created = await Api.Tournaments.CloneAsync(t.Id);
            Snackbar.Add("Tournament cloned", Severity.Success);
            Nav.NavigateTo($"/tournaments/{created.Id}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteAsync(TournamentDto t)
    {
        var ok = await DialogService.ShowMessageBox("Delete tournament", $"Delete '{t.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try { await Api.Tournaments.DeleteAsync(t.Id); Snackbar.Add("Deleted", Severity.Success); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
