@page "/divisions"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Divisions · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudText Typo="Typo.h4">Divisions</MudText>
    <CfToolbarAddButton OnClick="NewAsync" Disabled="@(TournamentStore?.SelectedTournamentId is null)" AriaLabel="Add division" />
</MudStack>

<MudDataGrid T="DivisionDto"
             Items="_items"
             Loading="_loading"
             Dense="true"
             Hover="true"
             MultiSelection="false">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <TemplateColumn Title="Format">
            <CellTemplate>@FormatLabel(context.Item.Format)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Stages">
            <CellTemplate>
                @if (context.Item.StageHints.Count == 0)
                {
                    <span class="mud-text-secondary">—</span>
                }
                else
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var hint in context.Item.StageHints)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StageChipColor(hint.Status)">
                                @StageChipLabel(hint)
                            </MudChip>
                        }
                    </MudStack>
                }
            </CellTemplate>
        </TemplateColumn>
        @if (_showWaveColumn)
        {
            <TemplateColumn Title="Wave">
                <CellTemplate>
                    @if (string.IsNullOrWhiteSpace(context.Item.WaveCode))
                    {
                        <span class="mud-text-secondary">—</span>
                    }
                    else
                    {
                        @context.Item.WaveCode
                    }
                </CellTemplate>
            </TemplateColumn>
        }
        <PropertyColumn Property="x => x.MaxTeams" Title="Max teams" />
        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudTooltip Text="Manage stages, pools &amp; brackets">
                    <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Href="@($"/divisions/{context.Item.Id}")" aria-label="Manage division" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context.Item))" aria-label="Edit division" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Item))" aria-label="Delete division" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private IReadOnlyList<DivisionDto> _items = Array.Empty<DivisionDto>();
    private bool _loading = true;
    private bool _showWaveColumn = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (TournamentStore is null)
            {
                Snackbar.Add("Tournament context is unavailable.", Severity.Error);
                _loading = false;
                return;
            }

            await TournamentStore.EnsureInitializedAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _loading = false; }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        var tid = TournamentStore.SelectedTournamentId;
        try
        {
            _items = tid is null ? Array.Empty<DivisionDto>() : await Api.Divisions.ListAsync(tid);
            _showWaveColumn = tid is null
                || TournamentStore.Tournaments.FirstOrDefault(t => t.Id == tid)?.SessionMode
                    == TournamentSessionModeDto.MultiWave;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private TournamentSessionModeDto SelectedSessionMode()
    {
        if (TournamentStore.SelectedTournamentId is not { } tid)
            return TournamentSessionModeDto.SingleSession;
        return TournamentStore.Tournaments.FirstOrDefault(t => t.Id == tid)?.SessionMode
               ?? TournamentSessionModeDto.SingleSession;
    }

    private async Task NewAsync()
    {
        if (TournamentStore.SelectedTournamentId is null) return;
        var parms = new DialogParameters
        {
            ["TournamentId"] = TournamentStore.SelectedTournamentId.Value,
            ["SessionMode"] = SelectedSessionMode()
        };
        var dialog = await DialogService.ShowAsync<DivisionDialog>("New division", parms);
        if ((await dialog.Result) is { Canceled: false }) await ReloadAsync();
    }

    private async Task EditAsync(DivisionDto d)
    {
        var parms = new DialogParameters
        {
            ["Existing"] = d,
            ["TournamentId"] = d.TournamentId,
            ["SessionMode"] = SelectedSessionMode()
        };
        var dialog = await DialogService.ShowAsync<DivisionDialog>("Edit division", parms);
        if ((await dialog.Result) is { Canceled: false }) await ReloadAsync();
    }

    private async Task DeleteAsync(DivisionDto d)
    {
        var ok = await DialogService.ShowMessageBoxAsync("Delete division", $"Delete '{d.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try { await Api.Divisions.DeleteAsync(d.Id); Snackbar.Add("Deleted", Severity.Success); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string FormatLabel(DivisionFormatDto format) => format switch
    {
        DivisionFormatDto.PoolOnly => "Pool only",
        DivisionFormatDto.PoolPlusBracket => "Pool + bracket",
        DivisionFormatDto.BracketOnly => "Bracket only",
        _ => format.ToString(),
    };

    private static string StageChipLabel(DivisionStageHintDto hint)
    {
        var type = hint.StageType switch
        {
            StageTypeDto.Pool => "Pool",
            StageTypeDto.Bracket => "Bracket",
            _ => hint.StageType.ToString(),
        };
        var status = hint.Status switch
        {
            StageStatusDto.Draft => "Draft",
            StageStatusDto.Configured => "Configured",
            StageStatusDto.Seeded => "Seeded",
            StageStatusDto.InProgress => "In progress",
            StageStatusDto.Completed => "Completed",
            _ => hint.Status.ToString(),
        };
        return $"{type}: {status}";
    }

    private static Color StageChipColor(StageStatusDto status) => status switch
    {
        StageStatusDto.Completed => Color.Success,
        StageStatusDto.InProgress => Color.Primary,
        StageStatusDto.Seeded => Color.Info,
        StageStatusDto.Configured => Color.Warning,
        _ => Color.Default,
    };
}
