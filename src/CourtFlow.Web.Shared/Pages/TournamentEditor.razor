@page "/tournaments/new"
@page "/tournaments/{Id:guid}"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_current is null ? "New tournament" : $"{_current.Name} · CourtFlow")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   aria-label="Back to tournaments"
                   OnClick="@(() => Nav.NavigateTo("/tournaments"))" />
    <MudText Typo="Typo.h4">@(_current is null ? "New tournament" : _current.Name)</MudText>
</MudStack>

@if (_current is not null)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Spacing="1" Style="flex:1; min-width:240px">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@PublicationChipColor()"
                             Variant="Variant.Filled">@PublicationStatusLabel()</MudChip>
                    @if (_current.PublicationStatus == TournamentPublicationStatusDto.Published)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@PublicEventUrl()</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           aria-label="Copy public link"
                                           OnClick="CopyPublicUrlAsync" />
                        </MudStack>
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@PublicationCaption()</MudText>
                @if (_current.PublishedAtUtc is not null || _current.ArchivedAtUtc is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@PublicationTimestamps()</MudText>
                }
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (_current.PublicationStatus == TournamentPublicationStatusDto.Draft)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Public"
                               Disabled="_busyPublication"
                               OnClick="ConfirmPublishAsync">Publish to public</MudButton>
                }
                else if (_current.PublicationStatus == TournamentPublicationStatusDto.Published)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Archive"
                               Disabled="_busyPublication"
                               OnClick="ConfirmArchiveAsync">Archive tournament</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.RestorePage"
                               Disabled="_busyPublication"
                               OnClick="RestoreAsync">Un-archive</MudButton>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Bookmark" OnClick="CaptureTemplateAsync">Save as template</MudButton>
                @if (_current.PublicationStatus != TournamentPublicationStatusDto.Draft)
                {
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.VisibilityOff" OnClick="ConfirmUnpublishAsync">Move to draft</MudMenuItem>
                    </MudMenu>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (_loadFailed)
{
    <MudAlert Severity="Severity.Error">Tournament not found.</MudAlert>
}
else
{
    <MudStack Spacing="4">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="2" Class="cf-form-details">
                <MudText Typo="Typo.h6">Details</MudText>
                <CfTextField @bind-Value="_name" Label="Name" Required="true" />
                <CfTextField @bind-Value="_description" Label="Description" Lines="2" />

                <MudDivider Class="my-1" />
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">Contact &amp; links</MudText>
                    <CfTextField @bind-Value="_websiteUrl"
                                 Label="Website"
                                 InputType="InputType.Url"
                                 Placeholder="https://example.com" />
                    <CfTextField @bind-Value="_contactEmail"
                                 Label="Contact email"
                                 InputType="InputType.Email"
                                 Placeholder="info@example.com" />
                </MudStack>

                <div class="cf-form-details__grid">
                    <div class="cf-field-wrap">
                        <CfDateField @bind-Date="_startDate" Label="Start date" />
                    </div>
                    <div class="cf-field-wrap">
                        <CfDateField @bind-Date="_endDate" Label="End date" />
                    </div>
                    <div class="cf-field-wrap">
                        <CfSelect T="string" @bind-Value="_tz" Label="Time zone"
                                   ToStringFunc="@(id => TimeZoneOptions.Label(id))">
                            @foreach (var tz in TimeZoneOptions.All)
                            {
                                <MudSelectItem T="string" Value="@tz.Id">@tz.Label</MudSelectItem>
                            }
                        </CfSelect>
                    </div>
                </div>

                @if (_current is not null)
                {
                    <MudDivider Class="my-1" />
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2">Match start times</MudText>
                        @if (_loadingWaves)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else
                        {
                            <MudRadioGroup T="TournamentSessionModeDto" @bind-Value="_sessionMode" Class="cf-session-mode">
                                <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                                    <MudRadio Value="TournamentSessionModeDto.SingleSession" Color="Color.Primary" Dense="true">
                                        Single session
                                    </MudRadio>
                                    <MudRadio Value="TournamentSessionModeDto.MultiWave" Color="Color.Primary" Dense="true">
                                        AM / PM waves
                                    </MudRadio>
                                </MudStack>
                            </MudRadioGroup>

                            <div class="cf-form-details__times">
                                @if (_sessionMode == TournamentSessionModeDto.SingleSession)
                                {
                                    <div class="cf-field-wrap">
                                        <CfTimeField @bind-Value="_singleStartTime" Label="Start time" />
                                    </div>
                                }
                                else
                                {
                                    <div class="cf-field-wrap">
                                        <CfTimeField @bind-Value="_amStartTime" Label="AM start" />
                                    </div>
                                    <div class="cf-field-wrap">
                                        <CfTimeField @bind-Value="_pmStartTime" Label="PM start" />
                                    </div>
                                }
                            </div>
                        }
                    </MudStack>
                }

                <MudDivider Class="my-1" />
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">Play format</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Applies to all divisions in this tournament — round robin, bracket only, or pool play then bracket.
                    </MudText>
                    <CfSelect T="DivisionFormatDto" @bind-Value="_playFormat" Label="Play format" Class="cf-select--md" ToStringFunc="@PlayFormatLabel">
                        <MudSelectItem T="DivisionFormatDto" Value="@DivisionFormatDto.PoolOnly">Round robin</MudSelectItem>
                        <MudSelectItem T="DivisionFormatDto" Value="@DivisionFormatDto.BracketOnly">Bracket only</MudSelectItem>
                        <MudSelectItem T="DivisionFormatDto" Value="@DivisionFormatDto.PoolPlusBracket">Pool + bracket</MudSelectItem>
                    </CfSelect>
                </MudStack>

                <MudDivider Class="my-1" />
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">Match duration</MudText>
                    <div class="cf-form-details__times">
                        <div class="cf-field-wrap">
                            <CfNumericField T="int" @bind-Value="_duration" Label="Duration (min)" Min="15" Max="240" />
                        </div>
                    </div>
                </MudStack>

                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveDetailsAsync"
                               Disabled="_savingDetails">
                        Save
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (_current is not null)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">Venues &amp; courts</MudText>
                        <CfToolbarAddButton OnClick="AddVenueAsync" AriaLabel="Add venue" />
                    </MudStack>

                    @if (_loadingVenues)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (_venues.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                            No venues yet. Use Add above.
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var v in _venues)
                            {
                                <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@v.Name</MudText>
                                            @if (!string.IsNullOrWhiteSpace(v.Address))
                                            {
                                                <MudText Typo="Typo.caption">@v.Address</MudText>
                                            }
                                            <MudText Typo="Typo.caption" Class="mt-1">
                                                @v.CourtCount court@(v.CourtCount == 1 ? "" : "s")
                                            </MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="0">
                                            <MudIconButton
                                                Icon="@Icons.Material.Filled.Edit"
                                                Size="Size.Small"
                                                aria-label="Edit venue"
                                                OnClick="@(() => EditVenueAsync(v))" />
                                            <MudIconButton
                                                Icon="@Icons.Material.Filled.Delete"
                                                Color="Color.Error"
                                                Size="Size.Small"
                                                aria-label="Delete venue"
                                                OnClick="@(() => DeleteVenueAsync(v))" />
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                Save tournament details to manage venues and courts.
            </MudAlert>
        }
    </MudStack>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private TournamentDto? _current;
    private bool _loadFailed;
    private bool _savingDetails;
    private bool _loadingVenues;
    private bool _loadingWaves;
    private List<TournamentWaveDto> _waves = new();
    private TournamentSessionModeDto _sessionMode = TournamentSessionModeDto.SingleSession;
    private string? _singleStartTime = LocalTimeFormat.DefaultMorningStart;
    private string? _amStartTime = LocalTimeFormat.DefaultMorningStart;
    private string? _pmStartTime = LocalTimeFormat.DefaultAfternoonStart;

    private string _name = "";
    private string? _description;
    private string? _websiteUrl;
    private string? _contactEmail;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today.AddDays(1);
    private string _tz = TimeZoneOptions.DefaultId;
    private int _duration = TournamentDefaults.DefaultMatchDurationMinutes;
    private DivisionFormatDto _playFormat = DivisionFormatDto.PoolPlusBracket;

    private List<VenueDto> _venues = new();

    private Guid? _lastLoadedId;
    private bool _busyPublication;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null)
        {
            if (_current is not null)
            {
                ResetNew();
            }
            return;
        }

        if (_lastLoadedId == Id) return;

        _lastLoadedId = Id;
        await LoadTournamentAsync(Id.Value);
        if (_current is not null)
        {
            await ReloadVenuesAsync();
            await ReloadWavesAsync();
        }
    }

    private void ResetNew()
    {
        _current = null;
        _name = "";
        _description = null;
        _websiteUrl = null;
        _contactEmail = null;
        _startDate = DateTime.Today;
        _endDate = DateTime.Today.AddDays(1);
        _tz = TimeZoneOptions.DefaultId;
        _duration = TournamentDefaults.DefaultMatchDurationMinutes;
        _playFormat = DivisionFormatDto.PoolPlusBracket;
        _venues = new();
    }

    private async Task LoadTournamentAsync(Guid id)
    {
        try
        {
            var t = await Api.Tournaments.GetAsync(id);
            if (t is null)
            {
                _loadFailed = true;
                return;
            }
            _current = t;
            _name = t.Name;
            _description = t.Description;
            _websiteUrl = t.WebsiteUrl;
            _contactEmail = t.ContactEmail;
            _startDate = t.StartDate.ToDateTime(TimeOnly.MinValue);
            _endDate = t.EndDate.ToDateTime(TimeOnly.MinValue);
            _tz = t.TimeZoneId;
            _duration = t.DefaultMatchDurationMinutes > 0
                ? t.DefaultMatchDurationMinutes
                : TournamentDefaults.DefaultMatchDurationMinutes;
            _playFormat = t.PlayFormat ?? TournamentStore.DefaultPlayFormat;
            _sessionMode = t.SessionMode;
            _singleStartTime = t.DefaultStartTime ?? LocalTimeFormat.DefaultMorningStart;
            BindWaveStartTimes();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadFailed = true;
        }
    }

    private async Task SaveDetailsAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Name is required.", Severity.Warning);
            return;
        }

        if (_current is not null && !await TryValidateSessionSettingsAsync())
            return;

        _savingDetails = true;
        try
        {
            var start = DateOnly.FromDateTime(_startDate ?? DateTime.Today);
            var end = DateOnly.FromDateTime(_endDate ?? DateTime.Today);

            if (_current is null)
            {
                var created = await Api.Tournaments.CreateAsync(
                    new CreateTournamentDto(_name.Trim(), _description, _websiteUrl, _contactEmail, start, end, _tz, _duration));
                _current = created;
                _lastLoadedId = created.Id;
                TournamentStore.SetDefaultPlayFormat(_playFormat);
                Snackbar.Add("Tournament created", Severity.Success);
                await TournamentStore.RefreshTournamentsAsync(created.Id);
                await ReloadVenuesAsync();
                await ReloadWavesAsync();
                Nav.NavigateTo($"/tournaments/{created.Id}", replace: true);
            }
            else
            {
                var previousPlayFormat = _current.PlayFormat;
                var updated = await Api.Tournaments.UpdateAsync(
                    new UpdateTournamentDto(_current.Id, _name.Trim(), _description, _websiteUrl, _contactEmail, start, end, _tz, _duration, _current.TournamentPartnerId));
                _current = updated;

                updated = await Api.Tournaments.UpsertSessionSettingsAsync(
                    _current.Id,
                    new UpsertTournamentSessionSettingsDto(
                        _sessionMode,
                        _sessionMode == TournamentSessionModeDto.SingleSession ? _singleStartTime?.Trim() : null,
                        _sessionMode == TournamentSessionModeDto.MultiWave ? _amStartTime?.Trim() : null,
                        _sessionMode == TournamentSessionModeDto.MultiWave ? _pmStartTime?.Trim() : null));
                _current = updated;
                _sessionMode = updated.SessionMode;
                _singleStartTime = updated.DefaultStartTime ?? LocalTimeFormat.DefaultMorningStart;

                if (previousPlayFormat != _playFormat)
                {
                    _current = await Api.Tournaments.SetPlayFormatAsync(
                        _current.Id, new SetTournamentPlayFormatDto(_playFormat));
                }

                TournamentStore.SetDefaultPlayFormat(_playFormat);
                await TournamentStore.RefreshTournamentsAsync();
                await ReloadWavesAsync();
                Snackbar.Add("Saved", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingDetails = false;
        }
    }

    private async Task<bool> TryValidateSessionSettingsAsync()
    {
        if (_sessionMode == TournamentSessionModeDto.SingleSession)
        {
            if (string.IsNullOrWhiteSpace(_singleStartTime))
            {
                Snackbar.Add("Start time is required.", Severity.Warning);
                return false;
            }

            if (!LocalTimeFormat.IsValidHhMm(_singleStartTime))
            {
                Snackbar.Add("Enter a valid start time.", Severity.Warning);
                return false;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_amStartTime) || string.IsNullOrWhiteSpace(_pmStartTime))
            {
                Snackbar.Add("AM and PM start times are required.", Severity.Warning);
                return false;
            }

            if (!LocalTimeFormat.IsValidHhMm(_amStartTime) || !LocalTimeFormat.IsValidHhMm(_pmStartTime))
            {
                Snackbar.Add("Enter valid start times.", Severity.Warning);
                return false;
            }
        }

        return true;
    }

    private Color PublicationChipColor() =>
        _current?.PublicationStatus switch
        {
            TournamentPublicationStatusDto.Published => Color.Success,
            TournamentPublicationStatusDto.Archived => Color.Info,
            _ => Color.Default,
        };

    private string PublicationStatusLabel() => _current?.PublicationStatus switch
    {
        TournamentPublicationStatusDto.Published => "Published",
        TournamentPublicationStatusDto.Archived => "Archived",
        _ => "Draft",
    };

    private string PublicEventUrl() => _current is null ? "" : Nav.ToAbsoluteUri($"/events/{_current.Id}").ToString();

    private string PublicationCaption() => _current?.PublicationStatus switch
    {
        TournamentPublicationStatusDto.Published =>
            "This tournament is visible on the public landing page.",
        TournamentPublicationStatusDto.Archived =>
            "Visible only as a past event. Shared links remain reachable.",
        _ =>
            "Not visible publicly. Publish to make this tournament discoverable on the public landing.",
    };

    private string PublicationTimestamps()
    {
        if (_current is null) return "";
        var parts = new List<string>();
        if (_current.PublishedAtUtc is { } pub)
            parts.Add($"Published {pub.ToLocalTime():g}");
        if (_current.ArchivedAtUtc is { } arc)
            parts.Add($"Archived {arc.ToLocalTime():g}");
        return string.Join(" · ", parts);
    }

    private async Task CopyPublicUrlAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", PublicEventUrl());
            Snackbar.Add("Public link copied.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmPublishAsync()
    {
        if (_current is null) return;
        var ok = await DialogService.ShowMessageBoxAsync(
            "Publish to public",
            "Make this tournament visible to the public? It will appear on the public landing page immediately. You can move it back to draft later.",
            yesText: "Publish",
            cancelText: "Cancel");
        if (ok != true) return;
        await RunPublicationActionAsync(async () => await Api.Tournaments.PublishAsync(_current.Id), "Tournament published.");
    }

    private async Task CaptureTemplateAsync()
    {
        if (_current is null) return;
        try
        {
            var template = await Api.Templates.CaptureAsync(new CaptureTemplateDto(_current.Id, $"Template from {_current.Name}"));
            Snackbar.Add($"Template \"{template.Name}\" saved", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ConfirmUnpublishAsync()
    {
        if (_current is null) return;
        var ok = await DialogService.ShowMessageBoxAsync(
            "Move to draft",
            "This will remove the tournament from the public landing and break shared /events links. The schedule, brackets, and standings will become inaccessible to the public. Continue?",
            yesText: "Move to draft",
            cancelText: "Cancel");
        if (ok != true) return;
        await RunPublicationActionAsync(async () => await Api.Tournaments.UnpublishAsync(_current.Id), "Moved to draft. The tournament is no longer publicly visible.");
    }

    private async Task ConfirmArchiveAsync()
    {
        if (_current is null) return;
        var ok = await DialogService.ShowMessageBoxAsync(
            "Archive tournament",
            "Archive this tournament? It will move from the active landing to a Past Events section. Shared links remain reachable.",
            yesText: "Archive",
            cancelText: "Cancel");
        if (ok != true) return;
        await RunPublicationActionAsync(async () => await Api.Tournaments.ArchiveAsync(_current.Id), "Tournament archived.");
    }

    private async Task RestoreAsync() =>
        await RunPublicationActionAsync(async () => await Api.Tournaments.RestoreAsync(_current!.Id), "Tournament restored to published.");

    private async Task RunPublicationActionAsync(Func<Task<TournamentDto>> action, string successMessage)
    {
        if (_current is null) return;
        _busyPublication = true;
        try
        {
            var t = await action();
            _current = t;
            await TournamentStore.RefreshTournamentsAsync();
            Snackbar.Add(successMessage, Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busyPublication = false;
        }
    }

    private async Task ReloadWavesAsync()
    {
        if (_current is null) return;
        _loadingWaves = true;
        try
        {
            _waves = (await Api.Waves.ListAsync(_current.Id)).ToList();
            BindWaveStartTimes();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingWaves = false;
        }
    }

    private void BindWaveStartTimes()
    {
        if (_current?.SessionMode != TournamentSessionModeDto.MultiWave)
            return;

        _amStartTime = _waves.FirstOrDefault(w => w.Code == "AM")?.DefaultStartTime ?? LocalTimeFormat.DefaultMorningStart;
        _pmStartTime = _waves.FirstOrDefault(w => w.Code == "PM")?.DefaultStartTime ?? LocalTimeFormat.DefaultAfternoonStart;
    }

    private async Task ReloadVenuesAsync()
    {
        if (_current is null) return;
        _loadingVenues = true;
        try
        {
            var venues = await Api.Venues.ListAsync(_current.Id);
            _venues = venues.OrderBy(v => v.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingVenues = false;
        }
    }

    private async Task AddVenueAsync()
    {
        if (_current is null) return;

        var parms = new DialogParameters
        {
            ["TournamentId"] = _current.Id
        };
        var dialog = await DialogService.ShowAsync<VenueDialog>("Add venue", parms);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadVenuesAsync();
        }
    }

    private async Task EditVenueAsync(VenueDto v)
    {
        if (_current is null) return;

        var parms = new DialogParameters
        {
            ["TournamentId"] = _current.Id,
            ["Existing"] = v
        };
        var dialog = await DialogService.ShowAsync<VenueDialog>("Edit venue", parms);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadVenuesAsync();
        }
    }

    private async Task DeleteVenueAsync(VenueDto v)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "Delete venue",
            $"Delete '{v.Name}' and all of its courts?",
            yesText: "Delete",
            cancelText: "Cancel");
        if (ok != true) return;

        try
        {
            await Api.Venues.DeleteAsync(v.Id);
            Snackbar.Add("Deleted", Severity.Success);
            await ReloadVenuesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string PlayFormatLabel(DivisionFormatDto format) => format switch
    {
        DivisionFormatDto.PoolOnly => "Round robin",
        DivisionFormatDto.BracketOnly => "Bracket only",
        DivisionFormatDto.PoolPlusBracket => "Pool + bracket",
        _ => format.ToString(),
    };
}
