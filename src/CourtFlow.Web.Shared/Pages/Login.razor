@page "/login"
@layout PublicLayout

<PageTitle>Sign In · CourtFlow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h4" GutterBottom="true">Sign in to CourtFlow</MudText>

        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" type="email" name="email" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input class="form-control" type="password" name="password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
