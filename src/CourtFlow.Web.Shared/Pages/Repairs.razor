@page "/repairs"
@attribute [Authorize]
@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Repairs · CourtFlow</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">Repairs</MudText>
    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.PersonRemove" OnClick="TeamWithdrawalAsync" Disabled="_tid is null">Team withdrawal</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.ReportProblem" OnClick="CourtOutageAsync" Disabled="_tid is null">Court outage</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh" OnClick="ReloadAsync" Disabled="_loading" />
    </MudStack>
</MudStack>

@if (_tid is null)
{
    <MudAlert Severity="Severity.Info">Select a tournament to view repair history and trigger repairs.</MudAlert>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_jobs.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No repair jobs yet. Use the buttons above to trigger a repair when needed.</MudAlert>
}
else
{
    <MudTable Items="_jobs" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Trigger</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Trigger">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.TriggerType</MudChip>
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToString("g")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter] private SelectedTournamentStore TournamentStore { get; set; } = default!;

    private Guid? _tid;
    private List<RepairJobDto> _jobs = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await TournamentStore.EnsureInitializedAsync();
        _tid = TournamentStore.SelectedTournamentId;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_tid is null) return;
        _loading = true;
        try { _jobs = (await Api.Repairs.ListAsync(_tid.Value)).ToList(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task TeamWithdrawalAsync()
    {
        if (_tid is null) return;
        var parms = new DialogParameters { ["TournamentId"] = _tid.Value };
        var dialog = await DialogService.ShowAsync<WithdrawTeamDialog>("Withdraw team", parms);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not TeamWithdrawalDto dto) return;

        try
        {
            await Api.Repairs.TeamWithdrawalAsync(_tid.Value, dto);
            Snackbar.Add("Team withdrawn", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task CourtOutageAsync()
    {
        if (_tid is null) return;
        var parms = new DialogParameters { ["TournamentId"] = _tid.Value };
        var dialog = await DialogService.ShowAsync<CourtOutageDialog>("Court unavailable", parms);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not CourtOutageDto dto) return;

        try
        {
            await Api.Repairs.CourtOutageAsync(_tid.Value, dto);
            Snackbar.Add("Court outage recorded", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static Color StatusColor(RepairJobStatusDto s) => s switch
    {
        RepairJobStatusDto.Applied => Color.Success,
        RepairJobStatusDto.Rejected => Color.Error,
        RepairJobStatusDto.Previewing => Color.Warning,
        _ => Color.Default
    };
}
