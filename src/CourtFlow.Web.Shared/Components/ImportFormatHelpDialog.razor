<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3 mud-secondary-text">
            Use a header row that matches one of the formats below. The import type is detected from the column names (<code>PoolName</code> for predefined pools, <code>Rank</code> for ranked teams).
        </MudText>
        <MudTabs Elevation="0" Outlined="true" Rounded="true">
            <MudTabPanel Text="Predefined pools">
                <MudStack Spacing="2" Class="pt-2">
                    <MudText Typo="Typo.body2">
                        Assign teams to divisions and named pools. Optional <code>SeedHint</code> supplies pool seed order when applicable.
                    </MudText>
                    <MudText Typo="Typo.subtitle2">Columns</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string"><strong>DivisionName</strong>, <strong>PoolName</strong>, <strong>TeamName</strong> (required)</MudListItem>
                        <MudListItem T="string"><strong>Club</strong>, <strong>Wave</strong> (required; use empty cell if no club)</MudListItem>
                        <MudListItem T="string"><strong>SeedHint</strong> (optional, integer)</MudListItem>
                    </MudList>
                    <MudText Typo="Typo.subtitle2">Wave</MudText>
                    <MudText Typo="Typo.body2"><code>AM</code> or <code>PM</code>, or <code>1</code> / <code>2</code>.</MudText>
                    <MudText Typo="Typo.subtitle2">Example</MudText>
                    <pre class="cf-import-example">DivisionName,PoolName,TeamName,Club,Wave,SeedHint
Open,A,Thunder FC,North,AM,
Open,A,River SC,,PM,1</pre>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Ranked teams">
                <MudStack Spacing="2" Class="pt-2">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Ranked import auto-builds pools: minimum 3 teams, prefers 4-team pools, and uses one 5-team pool when exactly 5 teams.
                    </MudAlert>
                    <MudText Typo="Typo.subtitle2">Columns</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string"><strong>DivisionName</strong>, <strong>Rank</strong>, <strong>TeamName</strong> (required)</MudListItem>
                        <MudListItem T="string"><strong>Club</strong>, <strong>Wave</strong> (required)</MudListItem>
                    </MudList>
                    <MudText Typo="Typo.subtitle2">Wave</MudText>
                    <MudText Typo="Typo.body2"><code>AM</code> or <code>PM</code>, or <code>1</code> / <code>2</code>.</MudText>
                    <MudText Typo="Typo.subtitle2">Example</MudText>
                    <pre class="cf-import-example">DivisionName,Rank,TeamName,Club,Wave
Open,1,Thunder FC,North,AM
Open,2,River SC,,PM</pre>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .cf-import-example {
        margin: 0;
        padding: 12px;
        border-radius: 8px;
        background: var(--mud-palette-background-grey);
        font-size: 0.8125rem;
        overflow-x: auto;
        white-space: pre;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private void Close() => Dialog.Close();
}
