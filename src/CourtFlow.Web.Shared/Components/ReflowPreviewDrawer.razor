@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDrawer @bind-Open="_open" Anchor="Anchor.Right" Elevation="2" Width="360px">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Reflow preview</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _open = false" />
    </MudDrawerHeader>
    <MudDrawerContainer Class="pa-4">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_notes.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No reflow suggestions.</MudAlert>
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var n in _notes)
                {
                    <MudListItem T="string">@n</MudListItem>
                }
            </MudList>
            <MudButton Class="mt-3"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Disabled="_applying || string.IsNullOrEmpty(_applyToken)"
                       OnClick="ApplyAsync">
                Apply as repair
            </MudButton>
        }
    </MudDrawerContainer>
</MudDrawer>

@code {
    [Parameter] public Guid? TournamentId { get; set; }

    private bool _open;
    private bool _loading;
    private bool _applying;
    private string? _applyToken;
    private IReadOnlyList<string> _notes = Array.Empty<string>();

    public async Task OpenAsync()
    {
        if (TournamentId is null) return;
        _open = true;
        _loading = true;
        _applyToken = null;
        try
        {
            var preview = await Api.CourtStatus.ReflowPreviewAsync(TournamentId.Value);
            _notes = preview.Notes;
            _applyToken = preview.ApplyToken;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _notes = Array.Empty<string>();
        }
        finally { _loading = false; }
    }

    private async Task ApplyAsync()
    {
        if (TournamentId is null || string.IsNullOrEmpty(_applyToken)) return;
        _applying = true;
        try
        {
            var result = await Api.CourtStatus.ReflowApplyAsync(
                TournamentId.Value,
                new CourtFlow.ApiClient.ReflowApplyDto(_applyToken));
            Snackbar.Add($"Reflow applied — {result.AssignmentsUpdated} assignment(s) updated (repair {result.RepairJobId.ToString()[..8]}…).", Severity.Success);
            _open = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _applying = false; }
    }
}
