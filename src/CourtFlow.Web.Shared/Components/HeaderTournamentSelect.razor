@implements IDisposable
@inject NavigationManager Nav

@if (_show)
{
    <MudText Typo="Typo.body2" Class="mr-2">Tournament</MudText>
    <MudSelect T="Guid?"
               Value="@Store.SelectedTournamentId"
               ValueChanged="OnValueChanged"
               Dense="true"
               Margin="Margin.Dense"
               Variant="Variant.Outlined"
               Class="cf-select--lg header-tournament-select"
               ToStringFunc="_tournamentName">
        @foreach (var t in Store.Tournaments)
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)t.Id)">@t.Name</MudSelectItem>
        }
    </MudSelect>
}

@code {
    [CascadingParameter] public SelectedTournamentStore Store { get; set; } = default!;

    private bool _show;
    private Func<Guid?, string> _tournamentName =>
        id => id is null ? string.Empty
            : Store.Tournaments.FirstOrDefault(t => t.Id == id)?.Name ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        Nav.LocationChanged += OnLocationChanged;
        await SyncVisibilityAndInitAsync();
    }

    private void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await SyncVisibilityAndInitAsync();
            StateHasChanged();
        });

    private async Task SyncVisibilityAndInitAsync()
    {
        _show = !IsUnderTournamentsRoute();
        if (_show)
            await Store.EnsureInitializedAsync();
    }

    private bool IsUnderTournamentsRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').ToLowerInvariant();
        return path == "tournaments" || path.StartsWith("tournaments/", StringComparison.Ordinal);
    }

    private async Task OnValueChanged(Guid? value) => await Store.SetSelectedAsync(value);

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
