@inject CourtFlow.ApiClient.CourtFlowApiClient Api

@inject ISnackbar Snackbar

@inject IDialogService DialogService



<MudExpansionPanels Elevation="0" Class="mt-3 mud-width-full">

    <MudExpansionPanel Text="Advanced · Match connections">

        <MudStack Spacing="2">

            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">

                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddMatchAsync" Disabled="_busy">Add match</MudButton>

                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ResolveSourcesAsync" Disabled="_busy">Resolve pool/rank sources</MudButton>

                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadAsync" Disabled="_busy">Refresh</MudButton>

            </MudStack>

            @if (_loading)

            {

                <MudProgressLinear Indeterminate="true" />

            }

            else if (_graph?.Matches.Count == 0)

            {

                <MudText Typo="Typo.body2" Color="Color.Secondary">No matches yet. Generate pools/brackets or add a match manually.</MudText>

            }

            else

            {

                @if (DependencyEdges().Count > 0)

                {

                    <MudPaper Class="pa-2" Outlined="true" Elevation="0">

                        <MudText Typo="Typo.caption" Class="mb-1 mud-text-secondary">Dependency graph</MudText>

                        @foreach (var edge in DependencyEdges())

                        {

                            <MudText Typo="Typo.caption">Game @edge.ToDisplay · @edge.SlotLabel ← @edge.SourceLabel</MudText>

                        }

                    </MudPaper>

                }

                <MudTable Items="_graph!.Matches" Dense="true" Hover="true">

                    <HeaderContent>

                        <MudTh>#</MudTh>

                        <MudTh>Match</MudTh>

                        <MudTh>Connections</MudTh>

                        <MudTh></MudTh>

                    </HeaderContent>

                    <RowTemplate>

                        <MudTd>@context.DisplayNumber</MudTd>

                        <MudTd>@MatchTeamsLabel(context.Match)</MudTd>

                        <MudTd>@ConnectionsSummary(context)</MudTd>

                        <MudTd>

                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditConnectionsAsync(context))" />

                            @if (context.Match.BracketNodeId is null && context.Match.State == MatchStateDto.NotStarted)

                            {

                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteMatchAsync(context.Match.Id))" />

                            }

                        </MudTd>

                    </RowTemplate>

                </MudTable>

            }

        </MudStack>

    </MudExpansionPanel>

</MudExpansionPanels>



@code {

    [Parameter] public Guid DivisionId { get; set; }

    [Parameter] public Guid? DefaultStageId { get; set; }

    [Parameter] public Guid? DefaultPoolId { get; set; }

    [Parameter] public IReadOnlyList<TeamDto> Teams { get; set; } = Array.Empty<TeamDto>();

    [Parameter] public IReadOnlyList<EditablePoolOption> Pools { get; set; } = Array.Empty<EditablePoolOption>();

    [Parameter] public IReadOnlyList<CreateMatchDialog.CourtOption> Courts { get; set; } = Array.Empty<CreateMatchDialog.CourtOption>();

    [Parameter] public EventCallback OnChanged { get; set; }



    public sealed record EditablePoolOption(Guid Id, string Name);



    private DivisionMatchGraphDto? _graph;

    private bool _loading = true;

    private bool _busy;



    protected override async Task OnParametersSetAsync() => await LoadAsync();



    public async Task LoadAsync()

    {

        if (DivisionId == Guid.Empty) return;

        _loading = true;

        try

        {

            _graph = await Api.Divisions.GetMatchGraphAsync(DivisionId);

        }

        catch (Exception ex)

        {

            Snackbar.Add(ex.Message, Severity.Error);

            _graph = null;

        }

        finally

        {

            _loading = false;

        }

    }



    private async Task AddMatchAsync()

    {

        var parameters = new DialogParameters<CreateMatchDialog>

        {

            { x => x.DivisionId, DivisionId },

            { x => x.StageId, DefaultStageId },

            { x => x.PoolId, DefaultPoolId },

            { x => x.Courts, Courts },

            { x => x.Teams, Teams }

        };

        var dialog = await DialogService.ShowAsync<CreateMatchDialog>("Add match", parameters);

        var result = await dialog.Result;

        if (result is { Canceled: false })

        {

            await LoadAsync();

            await OnChanged.InvokeAsync();

        }

    }



    private async Task DeleteMatchAsync(Guid matchId)

    {

        _busy = true;

        try

        {

            await Api.Matches.DeleteAsync(matchId);

            Snackbar.Add("Match removed", Severity.Success);

            await LoadAsync();

            await OnChanged.InvokeAsync();

        }

        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }

        finally { _busy = false; }

    }



    private async Task ResolveSourcesAsync()

    {

        _busy = true;

        try

        {

            await Api.Divisions.ResolveMatchSourcesAsync(DivisionId);

            Snackbar.Add("Pool and ranking sources resolved", Severity.Success);

            await LoadAsync();

            await OnChanged.InvokeAsync();

        }

        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }

        finally { _busy = false; }

    }



    private async Task EditConnectionsAsync(DivisionMatchGraphMatchDto row)

    {

        var allMatches = _graph?.Matches ?? Array.Empty<DivisionMatchGraphMatchDto>();

        var parameters = new DialogParameters<MatchSlotSourceDialog>

        {

            { x => x.Match, row },

            { x => x.AllMatches, allMatches },

            { x => x.Teams, Teams },

            { x => x.Pools, Pools }

        };

        var dialog = await DialogService.ShowAsync<MatchSlotSourceDialog>("Edit connections", parameters);

        var result = await dialog.Result;

        if (result is { Canceled: false })

        {

            await LoadAsync();

            await OnChanged.InvokeAsync();

        }

    }



    private List<DependencyEdge> DependencyEdges()

    {

        if (_graph is null) return [];

        var byId = _graph.Matches.ToDictionary(m => m.Match.Id, m => m.DisplayNumber);

        var edges = new List<DependencyEdge>();

        foreach (var row in _graph.Matches)

        {

            foreach (var src in row.SlotSources.Where(s =>

                         s.SourceKind is MatchSlotSourceKindDto.MatchWinner or MatchSlotSourceKindDto.MatchLoser))

            {

                if (src.SourceMatchId is not { } fromId || !byId.TryGetValue(fromId, out var fromNum))

                    continue;

                var kind = src.SourceKind == MatchSlotSourceKindDto.MatchWinner ? "Winner" : "Loser";

                edges.Add(new DependencyEdge(

                    row.DisplayNumber,

                    src.Slot.ToString(),

                    $"{kind} of game {fromNum}"));

            }

        }

        return edges.OrderBy(e => e.ToDisplay).ThenBy(e => e.SlotLabel).ToList();

    }



    private static string MatchTeamsLabel(MatchDto m)

    {

        var home = m.HomeTeamId?.ToString()[..8] ?? "TBD";

        var away = m.AwayTeamId?.ToString()[..8] ?? "TBD";

        return $"{home} vs {away}";

    }



    private static string ConnectionsSummary(DivisionMatchGraphMatchDto row)

    {

        if (row.SlotSources.Count == 0) return "—";

        return string.Join(" · ", row.SlotSources.Select(SlotLabel));

    }



    private static string SlotLabel(MatchSlotSourceDto s) => s.SourceKind switch

    {

        MatchSlotSourceKindDto.FixedTeam => $"{s.Slot}: team",

        MatchSlotSourceKindDto.MatchWinner => $"{s.Slot}: W#{s.SourceMatchId?.ToString()[..4]}",

        MatchSlotSourceKindDto.MatchLoser => $"{s.Slot}: L#{s.SourceMatchId?.ToString()[..4]}",

        MatchSlotSourceKindDto.PoolFinish => $"{s.Slot}: pool P{s.SourcePosition}",

        MatchSlotSourceKindDto.Ranking => $"{s.Slot}: seed {s.SourcePosition}",

        _ => s.Slot.ToString()

    };



    private sealed record DependencyEdge(int ToDisplay, string SlotLabel, string SourceLabel);

}

