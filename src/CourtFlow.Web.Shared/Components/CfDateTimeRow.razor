<MudStack Spacing="1">
    @if (!string.IsNullOrEmpty(Label))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Label</MudText>
    }
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Start">
        <div class="cf-field-wrap @WrapClass">
            <CfDateField Label="Date"
                         Date="Date"
                         DateChanged="OnDateChanged"
                         Required="@Required"
                         Disabled="@Disabled" />
        </div>
        <div class="cf-field-wrap @WrapClass">
            <CfTimeField Label="Time"
                         Time="Time"
                         TimeChanged="OnTimeChanged"
                         Required="@Required"
                         Disabled="@Disabled" />
        </div>
    </MudStack>
</MudStack>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public EventCallback<DateTime?> DateChanged { get; set; }
    [Parameter] public TimeSpan? Time { get; set; }
    [Parameter] public EventCallback<TimeSpan?> TimeChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private string WrapClass => string.IsNullOrWhiteSpace(Class) ? "cf-field--md" : Class;

    private async Task OnDateChanged(DateTime? value)
    {
        Date = value;
        await DateChanged.InvokeAsync(value);
    }

    private async Task OnTimeChanged(TimeSpan? value)
    {
        Time = value;
        await TimeChanged.InvokeAsync(value);
    }
}
