@typeparam T

<MudAutocomplete T="T"
                 Value="Value"
                 ValueChanged="ValueChanged"
                 Label="@Label"
                 Dense="true"
                 Margin="Margin.Dense"
                 Variant="Variant.Outlined"
                 Class="@Class"
                 Style="@Style"
                 Clearable="@Clearable"
                 Strict="@Strict"
                 CoerceText="@CoerceText"
                 ResetValueOnEmptyText="@ResetValueOnEmptyText"
                 Placeholder="@Placeholder"
                 MaxItems="@MaxItems"
                 FullWidth="@FullWidth"
                 Disabled="@Disabled"
                 SearchFunc="@SearchFunc"
                 ToStringFunc="@ToStringFunc" />

@code {
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool Strict { get; set; } = true;
    [Parameter] public bool CoerceText { get; set; }
    [Parameter] public bool ResetValueOnEmptyText { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int MaxItems { get; set; } = 10;
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Func<T?, string>? ToStringFunc { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<T>>>? SearchFunc { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
}
