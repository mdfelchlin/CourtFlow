@using CourtFlow.Web.Shared.Brackets
@inject CourtFlow.ApiClient.CourtFlowApiClient Api

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="my-2" />
}
else if (_nodes.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No bracket nodes.</MudText>
}
else
{
    @if (ShowScrollHint)
    {
        <MudText Typo="Typo.caption" Class="cf-bracket-tree-hint">Scroll horizontally to explore the bracket.</MudText>
    }
    <div class="cf-bracket-tree-scroll @(Compact ? "cf-bracket-tree-scroll--compact" : "")">
        <div class="cf-bracket-canvas" style="@CanvasStyle">
            <svg class="cf-bracket-connectors"
                 width="@_layout.CanvasWidth"
                 height="@_layout.CanvasHeight"
                 viewBox="0 0 @_layout.CanvasWidth @_layout.CanvasHeight"
                 aria-hidden="true">
                @foreach (var connector in _layout.Connectors)
                {
                    <path d="@connector.Path"
                          class="cf-bracket-connector @ConnectorClass(connector.Kind)" />
                }
                @foreach (var junction in _layout.Junctions)
                {
                    <circle cx="@junction.X"
                            cy="@junction.Y"
                            r="3"
                            class="cf-bracket-junction @ConnectorClass(junction.Kind)" />
                }
            </svg>
            @foreach (var section in _layout.Sections.Values.OrderBy(s => s.Y))
            {
                @if (!string.IsNullOrEmpty(section.Title))
                {
                    <div class="cf-bracket-band @(section.HasDividerAbove ? "cf-bracket-band--divided" : "")"
                         style="left: @(section.X)px; top: @(section.Y)px; width: @(_layout.CanvasWidth - section.X)px; height: @(section.Height)px;">
                        <div class="cf-bracket-band__title">@section.Title</div>
                        @if (!string.IsNullOrEmpty(section.Subtitle))
                        {
                            <div class="cf-bracket-band__subtitle">@section.Subtitle</div>
                        }
                    </div>
                }
            }
            @foreach (var column in _layout.RoundColumns)
            {
                <div class="cf-bracket-round-header"
                     style="left: @(column.X)px; top: @(column.HeaderY)px; width: @(column.Width)px;">
                    @column.Label
                </div>
            }
            @foreach (var positioned in _layout.Nodes)
            {
                var node = _nodeById[positioned.Id];
                <div class="cf-bracket-node"
                     style="left: @(positioned.X)px; top: @(positioned.Y)px; width: @(positioned.Width)px; height: @(positioned.Height)px;">
                    <BracketMatchCard MatchLabel="@(node.MatchLabel ?? _matchLabels.GetValueOrDefault(node.Id, ""))"
                                      HomeLabel="@node.HomeLabel"
                                      AwayLabel="@node.AwayLabel"
                                      HomeIsBye="@node.HomeIsBye"
                                      AwayIsBye="@node.AwayIsBye"
                                      IsPinnedHome="@node.IsPinnedHome"
                                      IsPinnedAway="@node.IsPinnedAway"
                                      MatchId="@node.MatchId"
                                      MatchState="@node.MatchState"
                                      HomeSetsSummary="@node.HomeSetsSummary"
                                      AwaySetsSummary="@node.AwaySetsSummary"
                                      WinnerSide="@node.WinnerSide"
                                      CourtName="@node.CourtName"
                                      ScheduledStartUtc="@node.ScheduledStartUtc"
                                      PathHighlighted="@IsPathHighlighted(node.Id)" />
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid? BracketId { get; set; }
    [Parameter] public IReadOnlyList<BracketTreeNodeDto>? Nodes { get; set; }
    [Parameter] public Guid? HighlightedTeamId { get; set; }
    [Parameter] public bool Compact { get; set; }

    private static readonly BracketLayoutOptions CompactOptions = new(
        CardWidth: 168,
        CardHeight: 52,
        ConnectorGap: 40,
        RoundHeaderBandHeight: 24,
        MatchVerticalGap: 10);

    private static readonly BracketLayoutOptions DefaultOptions = new();

    private bool _loading;
    private IReadOnlyList<BracketTreeNodeDto> _nodes = Array.Empty<BracketTreeNodeDto>();
    private BracketLayoutResult _layout = EmptyLayout;
    private Dictionary<Guid, BracketTreeNodeDto> _nodeById = new();
    private Dictionary<Guid, string> _matchLabels = new();
    private HashSet<Guid> _pathHighlightedIds = new();

    private static readonly BracketLayoutResult EmptyLayout = new(
        Array.Empty<PositionedBracketNode>(),
        Array.Empty<BracketConnector>(),
        Array.Empty<BracketJunction>(),
        Array.Empty<BracketRoundColumn>(),
        new Dictionary<BracketBranchDto, BracketLayoutSection>(),
        0,
        0,
        28);

    private BracketLayoutEngine _engine = new();

    private bool ShowScrollHint => !Compact && _nodes.Count >= 15;

    protected override async Task OnParametersSetAsync()
    {
        var needsFetch = BracketId is not null && Nodes is null;
        _loading = needsFetch;
        try
        {
            if (Nodes is not null)
            {
                _nodes = Nodes;
            }
            else if (BracketId is { } bracketId)
            {
                var tree = await Api.Brackets.GetTreeAsync(bracketId);
                _nodes = tree?.Nodes ?? Array.Empty<BracketTreeNodeDto>();
            }
            else
            {
                _nodes = Array.Empty<BracketTreeNodeDto>();
            }

            RebuildLayout();
        }
        finally
        {
            _loading = false;
        }
    }

    private void RebuildLayout()
    {
        _nodeById = _nodes.ToDictionary(n => n.Id);
        _pathHighlightedIds = ComputePathHighlights(_nodes, HighlightedTeamId);
        _matchLabels = BracketMatchNumbering.BuildLabels(_nodes);

        var inputs = _nodes.Select(n => new BracketLayoutNodeInput(
            n.Id,
            n.Branch,
            n.Round,
            n.Slot,
            n.WinsToNodeId,
            n.LosesToNodeId)).ToList();

        var options = Compact ? CompactOptions : DefaultOptions;
        _layout = inputs.Count == 0 ? EmptyLayout : _engine.Layout(inputs, options);
    }

    private string CanvasStyle =>
        $"width: {_layout.CanvasWidth}px; height: {_layout.CanvasHeight}px; min-width: {_layout.CanvasWidth}px;";

    private bool IsPathHighlighted(Guid nodeId) => _pathHighlightedIds.Contains(nodeId);

    private static string ConnectorClass(BracketConnectorKind kind) =>
        kind == BracketConnectorKind.LosesTo ? "cf-bracket-connector--loses" : "";

    internal static HashSet<Guid> ComputePathHighlights(
        IReadOnlyList<BracketTreeNodeDto> nodes,
        Guid? teamId)
    {
        if (teamId is null || nodes.Count == 0) return new HashSet<Guid>();

        var byId = nodes.ToDictionary(n => n.Id);
        var feedersByTarget = nodes
            .Where(n => n.WinsToNodeId is not null)
            .GroupBy(n => n.WinsToNodeId!.Value)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Id).ToList());

        var highlighted = new HashSet<Guid>();
        var queue = new Queue<Guid>(
            nodes
                .Where(n => n.HomeTeamId == teamId || n.AwayTeamId == teamId)
                .Select(n => n.Id));

        while (queue.Count > 0)
        {
            var id = queue.Dequeue();
            if (!highlighted.Add(id) || !byId.TryGetValue(id, out var node)) continue;

            if (feedersByTarget.TryGetValue(id, out var feeders))
            {
                foreach (var feederId in feeders)
                {
                    queue.Enqueue(feederId);
                }
            }

            if (node.WinnerTeamId == teamId && node.WinsToNodeId is { } nextId && byId.ContainsKey(nextId))
            {
                queue.Enqueue(nextId);
            }
        }

        return highlighted;
    }
}
