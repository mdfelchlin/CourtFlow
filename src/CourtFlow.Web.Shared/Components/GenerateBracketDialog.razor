@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack>
            <MudSelect T="BracketTypeDto" @bind-Value="_type" Label="Bracket type" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="cf-select--md">
                <MudSelectItem Value="BracketTypeDto.SingleElimination">Single Elimination</MudSelectItem>
                <MudSelectItem Value="BracketTypeDto.DoubleElimination">Double Elimination</MudSelectItem>
            </MudSelect>
            <MudNumericField @bind-Value="_capacity" Label="Team capacity (power of 2)" Min="2" Max="64" />
            <MudCheckBox T="bool" @bind-Value="_ifNecessaryFinal" Label="If-necessary final (DE only)" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Generate">Generate</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid TournamentId { get; set; }
    [Parameter] public Guid DivisionId { get; set; }

    private BracketTypeDto _type = BracketTypeDto.SingleElimination;
    private int _capacity = 8;
    private bool _ifNecessaryFinal = true;

    private void Cancel() => Dialog.Cancel();

    private async Task Generate()
    {
        try
        {
            await Api.Brackets.GenerateAsync(new GenerateBracketDto(TournamentId, DivisionId, _type, _capacity, _ifNecessaryFinal));
            Snackbar.Add("Bracket generated", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
