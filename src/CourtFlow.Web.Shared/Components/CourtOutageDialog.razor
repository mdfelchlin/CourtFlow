@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudStack Spacing="2">
                <MudSelect T="Guid"
                           @bind-Value="_courtId"
                           Label="Court"
                           Required="true">
                    @foreach (var c in _courts)
                    {
                        <MudSelectItem Value="c.Id">@c.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker @bind-Date="_startDate" Label="Starts (date)" />
                <MudTimePicker @bind-Time="_startTime" Label="Starts (time)" />
                <MudDatePicker @bind-Date="_endDate" Label="Ends (date)" />
                <MudTimePicker @bind-Time="_endTime" Label="Ends (time)" />
                <MudTextField @bind-Value="_reason" Label="Reason" Lines="2" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Apply" Disabled="_loading || _courts.Count == 0">Apply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid TournamentId { get; set; }

    private bool _loading = true;
    private Guid _courtId;
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private string? _reason;
    private List<CourtOption> _courts = new();

    private sealed record CourtOption(Guid Id, string Label);

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;
        _startDate = now.Date;
        _startTime = now.TimeOfDay;
        _endDate = now.Date;
        _endTime = now.AddHours(2).TimeOfDay;

        try
        {
            var venues = await Api.Venues.ListAsync(TournamentId);
            var options = new List<CourtOption>();
            foreach (var v in venues.OrderBy(x => x.Name))
            {
                var courts = await Api.Courts.ListAsync(v.Id);
                foreach (var c in courts.OrderBy(x => x.Name))
                    options.Add(new CourtOption(c.Id, $"{v.Name} · {c.Name}"));
            }
            _courts = options;
            if (_courts.Count > 0)
                _courtId = _courts[0].Id;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel() => Dialog.Cancel();

    private void Apply()
    {
        var starts = CombineUtc(_startDate, _startTime);
        var ends = CombineUtc(_endDate, _endTime);
        if (ends <= starts)
        {
            Snackbar.Add("End must be after start.", Severity.Warning);
            return;
        }

        Dialog.Close(DialogResult.Ok(new CourtOutageDto(_courtId, starts, ends, _reason)));
    }

    private static DateTime CombineUtc(DateTime? date, TimeSpan? time)
    {
        var d = date ?? DateTime.UtcNow.Date;
        var t = time ?? TimeSpan.Zero;
        return DateTime.SpecifyKind(d.Date.Add(t), DateTimeKind.Utc);
    }
}
