@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack>
                <CfTextField @bind-Value="_name"
                             Label="Name"
                             Required="true"
                             Immediate="true"
                             OnKeyDown="HandleKeyDown" />
                @if (Existing is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Play format: @FormatLabel(_playFormat) (set at tournament level)
                    </MudText>
                    <CfNumericField T="int" @bind-Value="_maxTeams" Label="Max teams" Min="2" Max="128" Immediate="true" />
                }
            </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="_saving">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public DivisionDto? Existing { get; set; }
    [Parameter] public Guid TournamentId { get; set; }
    [Parameter] public DivisionFormatDto PlayFormat { get; set; } = DivisionFormatDto.PoolPlusBracket;

    private string _name = "";
    private DivisionFormatDto _playFormat = DivisionFormatDto.PoolPlusBracket;
    private int _maxTeams = 16;
    private bool _saving;

    protected override void OnInitialized()
    {
        _playFormat = PlayFormat;

        if (Existing is not null)
        {
            _name = Existing.Name;
            _playFormat = Existing.Format;
            _maxTeams = Existing.MaxTeams;
        }
    }

    private static string FormatLabel(DivisionFormatDto format) => format switch
    {
        DivisionFormatDto.PoolOnly => "Round robin",
        DivisionFormatDto.PoolPlusBracket => "Pool + bracket",
        DivisionFormatDto.BracketOnly => "Bracket only",
        _ => format.ToString(),
    };

    private void Cancel() => Dialog.Cancel();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            await Save();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Name is required.", Severity.Warning);
            return;
        }

        if (TournamentId == Guid.Empty)
        {
            Snackbar.Add("No tournament selected.", Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            if (Existing is null)
            {
                await Api.Divisions.CreateAsync(new CreateDivisionDto(TournamentId, _name.Trim()));
            }
            else
            {
                await Api.Divisions.UpdateAsync(new UpdateDivisionDto(Existing.Id, _name.Trim(), Existing.Format, _maxTeams));
            }
            Snackbar.Add("Saved", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
