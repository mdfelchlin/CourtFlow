@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <CfSelect T="Guid?" @bind-Value="_refTeamId" Label="Referee team" Clearable="true">
            @foreach (var t in Teams)
            {
                <MudSelectItem T="Guid?" Value="@t.Id">@t.Name</MudSelectItem>
            }
        </CfSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid MatchId { get; set; }
    [Parameter] public Guid? CurrentRefTeamId { get; set; }
    [Parameter] public IReadOnlyList<CourtFlow.ApiClient.TeamDto> Teams { get; set; } = Array.Empty<CourtFlow.ApiClient.TeamDto>();

    private Guid? _refTeamId;

    protected override void OnInitialized() => _refTeamId = CurrentRefTeamId;

    private void Cancel() => Dialog.Cancel();

    private async Task Confirm()
    {
        try
        {
            await Api.Matches.ChangeRefereeAsync(MatchId, new CourtFlow.ApiClient.ChangeRefereeDto(_refTeamId));
            Snackbar.Add("Referee updated", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
