<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mud-width-full">
            <MudText Typo="Typo.h6" Class="flex-grow-1">@BracketName · Bracket preview</MudText>
            @if (BracketId is not null)
            {
                <MudTooltip Text="@(_fullscreen ? "Exit full screen" : "Full screen")">
                    <MudIconButton Icon="@(_fullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                                   Size="Size.Small"
                                   OnClick="ToggleFullscreenAsync" />
                </MudTooltip>
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (BracketId is null)
        {
            <MudAlert Severity="Severity.Info" Dense="true">Generate brackets to preview the tree.</MudAlert>
        }
        else
        {
            <div class="@BodyClass">
                <BracketView BracketId="BracketId" Compact="false" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid? BracketId { get; set; }
    [Parameter] public string BracketName { get; set; } = "";

    private bool _fullscreen;

    private string BodyClass => _fullscreen
        ? "cf-bracket-preview__body cf-bracket-preview__body--fullscreen"
        : "cf-bracket-preview__body";

    private async Task ToggleFullscreenAsync()
    {
        _fullscreen = !_fullscreen;
        await Dialog.SetOptionsAsync(new DialogOptions
        {
            FullScreen = _fullscreen,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = !_fullscreen
        });
    }

    private void Close() => Dialog.Close();
}
