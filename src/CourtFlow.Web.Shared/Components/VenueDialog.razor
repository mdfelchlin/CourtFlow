@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="cf-venue-dialog__content">
            <MudStack Spacing="3">
                <CfTextField @bind-Value="_name" Label="Name" Required="true" />
                <AddressAutocomplete @bind-Value="_address" Label="Address" Lines="2" />

                <CfNumericField T="int" @bind-Value="_courtCount"
                                 Label="Number of courts"
                                 Min="0"
                                 Max="99"
                                 Immediate="true" />
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public VenueDto? Existing { get; set; }
    [Parameter] public Guid TournamentId { get; set; }

    private string _name = "";
    private string? _address;
    private int _courtCount;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await Dialog.SetOptionsAsync(new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        });

        if (Existing is not null)
        {
            _name = Existing.Name;
            _address = Existing.Address;
            _courtCount = Existing.CourtCount;
        }
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Name is required.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (Existing is null)
            {
                await Api.Venues.CreateAsync(new CreateVenueDto(TournamentId, _name.Trim(), _address, _courtCount));
            }
            else
            {
                await Api.Venues.UpdateAsync(new UpdateVenueDto(Existing.Id, _name.Trim(), _address, _courtCount));
            }

            Snackbar.Add("Saved", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
