<MudButton ButtonType="ButtonType.Button"
           StartIcon="@Icons.Material.Filled.Add"
           Color="Color.Primary"
           Variant="Variant.Filled"
           Size="Size.Small"
           Class="cf-toolbar-add"
           Disabled="@Disabled"
           aria-label="@EffectiveAriaLabel"
           OnClick="HandleClick">
    Add
</MudButton>

@code {
    /// <summary>Primary toolbar Add — same markup as the Tournaments page.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Optional context for assistive tech when multiple Add actions exist (e.g. "Add court").</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? "Add" : AriaLabel!;

    private Task HandleClick(MouseEventArgs _) => OnClick.InvokeAsync();
}
