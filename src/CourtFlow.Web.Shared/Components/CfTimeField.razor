<div class="@RootClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="cf-field__label">
            @Label@if (Required)
            {
                <span aria-hidden="true"> *</span>
            }
        </label>
    }
    <MudTimePicker @bind-Time="BoundTime"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   PickerVariant="PickerVariant.Dialog"
                   Editable="true"
                   AmPm="true"
                   TimeFormat="h:mm tt"
                   OpenTo="OpenTo.Minutes"
                   MinuteSelectionStep="5"
                   Adornment="Adornment.Start"
                   AdornmentIcon="@EffectiveAdornmentIcon"
                   Required="@Required"
                   Disabled="@Disabled"
                   HelperText="@EffectiveHelperText"
                   Error="@HasError"
                   Class="cf-field__control"
                   UserAttributes="@AriaAttributes" />
</div>

@code {
    private string? _lastValue;
    private bool _useStringBinding;

    [Parameter] public string? Label { get; set; }
    [Parameter] public TimeSpan? Time { get; set; }
    [Parameter] public EventCallback<TimeSpan?> TimeChanged { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AdornmentIcon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? ValidationError { get; set; }

    private string EffectiveAdornmentIcon =>
        string.IsNullOrWhiteSpace(AdornmentIcon)
            ? Icons.Material.Filled.Schedule
            : AdornmentIcon;

    private bool HasError =>
        !string.IsNullOrEmpty(ValidationError)
        || (_useStringBinding && !string.IsNullOrWhiteSpace(_lastValue) && !LocalTimeFormat.IsValidHhMm(_lastValue));

    private string? EffectiveHelperText =>
        HasError ? (ValidationError ?? "Enter a valid time.") : null;

    private TimeSpan? BoundTime
    {
        get => _useStringBinding ? LocalTimeFormat.TryParseHhMm(Value) : Time;
        set
        {
            if (_useStringBinding)
            {
                var formatted = LocalTimeFormat.ToHhMm(value);
                _lastValue = formatted;
                Value = formatted;
                _ = ValueChanged.InvokeAsync(formatted);
            }
            else
            {
                Time = value;
                _ = TimeChanged.InvokeAsync(value);
            }
        }
    }

    protected override void OnParametersSet()
    {
        _useStringBinding = ValueChanged.HasDelegate;

        if (_useStringBinding)
            _lastValue = Value;
    }

    private string RootClass =>
        string.IsNullOrWhiteSpace(Class)
            ? "cf-field cf-time-field"
            : $"cf-field cf-time-field {Class}";

    private Dictionary<string, object>? AriaAttributes =>
        string.IsNullOrWhiteSpace(Label)
            ? null
            : new Dictionary<string, object> { ["aria-label"] = Label };
}
