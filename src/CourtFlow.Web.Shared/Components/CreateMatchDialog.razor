@inject CourtFlow.ApiClient.CourtFlowApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <CfDateTimeRow @bind-Date="_date" @bind-Time="_time" Class="cf-field--sm" />
            <CfNumericField T="int" @bind-Value="_duration" Label="Duration (min)" Min="15" Max="240" />
            <CfSelect T="Guid?" @bind-Value="_courtId" Label="Court" Clearable="true" ToStringFunc="_courtLabel">
                @foreach (var c in Courts)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">@c.Label</MudSelectItem>
                }
            </CfSelect>
            <CfSelect T="Guid?" @bind-Value="_homeTeamId" Label="Home team" Clearable="true">
                @foreach (var t in Teams)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)t.Id)">@TeamDisplay.Label(t.Club, t.Name)</MudSelectItem>
                }
            </CfSelect>
            <CfSelect T="Guid?" @bind-Value="_awayTeamId" Label="Away team" Clearable="true">
                @foreach (var t in Teams)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)t.Id)">@TeamDisplay.Label(t.Club, t.Name)</MudSelectItem>
                }
            </CfSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Add match</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid DivisionId { get; set; }
    [Parameter] public Guid? StageId { get; set; }
    [Parameter] public Guid? PoolId { get; set; }
    [Parameter] public IReadOnlyList<CourtOption> Courts { get; set; } = Array.Empty<CourtOption>();
    [Parameter] public IReadOnlyList<TeamDto> Teams { get; set; } = Array.Empty<TeamDto>();

    public sealed record CourtOption(Guid Id, string Label);

    private DateTime? _date = DateTime.Today;
    private TimeSpan? _time = new(8, 0, 0);
    private int _duration = 60;
    private Guid? _courtId;
    private Guid? _homeTeamId;
    private Guid? _awayTeamId;
    private bool _busy;

    private Func<Guid?, string> _courtLabel =>
        id => id is null ? string.Empty : Courts.FirstOrDefault(c => c.Id == id)?.Label ?? string.Empty;

    private void Cancel() => Dialog.Cancel();

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var start = (_date ?? DateTime.Today).Add(_time ?? TimeSpan.Zero).ToUniversalTime();
            await Api.Matches.CreateAsync(new CreateDivisionMatchDto(
                DivisionId,
                StageId,
                PoolId,
                _courtId,
                start,
                _duration,
                _homeTeamId,
                _awayTeamId,
                null));
            Snackbar.Add("Match added", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
